---
import { Image } from 'astro:assets';
import { siteConfig } from '../data/site';
import { ui } from '../data/ui';
import SnsLinks from './common/SnsLinks.astro';
import profileImg from '../assets/images/common/profile.jpg';
---

<section id="about" class="pt-20 pb-0">
  <div class="flex items-baseline gap-2 mb-6">
    <h2 class="text-2xl font-bold text-white">
      <span class="lang-ja">{ui.ja.sections.aboutTitle}</span>
      <span class="lang-en">{ui.en.sections.aboutTitle}</span>
    </h2>
    <span class="lang-ja text-xs text-gray-400">{ui.ja.sections.aboutSubtitle}</span>
  </div>

  <div class="bg-slate-800/50 p-6 md:p-8 border border-slate-800">
    <div class="flex flex-col md:flex-row items-center gap-6">
      <Image
        src={profileImg}
        alt={siteConfig.ja.author}
        class="w-48 h-48 md:w-56 md:h-56 rounded-full object-cover border border-slate-700 shrink-0"
      />

      <div class="space-y-3">
        <h3 class="text-xl font-bold text-white">
          <span class="lang-ja">{siteConfig.ja.author}</span>
          <span class="lang-en">{siteConfig.en.author}</span>
        </h3>

        <p class="text-gray-300 whitespace-pre-line leading-relaxed text-sm md:text-base">
          <span class="lang-ja">{siteConfig.ja.bio}</span>
          <span class="lang-en">{siteConfig.en.bio}</span>
        </p>
      </div>
    </div>

    <div class="mt-8 pt-6 border-t border-slate-700/70">
      <SnsLinks />
    </div>
  </div>
</section>

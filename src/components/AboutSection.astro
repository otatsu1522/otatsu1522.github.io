---
import { Image } from 'astro:assets';
import { siteConfig } from '../data/site';
import { ui } from '../data/ui';
import SnsLinks from './common/SnsLinks.astro';
import profileImg from '../assets/images/common/profile.jpg';
---

<section id="about" class="pb-0 pt-20">
  <div class="flex flex-col items-center gap-10 md:flex-row md:items-start md:gap-14 lg:gap-20">
    <Image
      src={profileImg}
      alt={siteConfig.ja.author}
      class="aspect-square h-64 w-64 shrink-0 border border-[var(--color-border)] object-cover md:h-80 md:w-80 lg:h-96 lg:w-96"
    />

    <div class="w-full flex-1">
      <h2 class="mb-10 text-4xl font-bold text-[var(--color-text)] md:text-5xl">
        <span class="lang-ja">{ui.ja.sections.aboutTitle}</span>
        <span class="lang-en">{ui.en.sections.aboutTitle}</span>
      </h2>

      <h3 class="text-2xl font-bold text-[var(--color-text)] md:text-3xl">
        <span class="lang-ja">{siteConfig.ja.author}</span>
        <span class="lang-en">{siteConfig.en.author}</span>
      </h3>

      <p
        class="mt-4 whitespace-pre-line text-sm leading-relaxed text-[var(--color-muted)] md:text-base"
      >
        <span class="lang-ja">{siteConfig.ja.bio}</span>
        <span class="lang-en">{siteConfig.en.bio}</span>
      </p>

      <div class="mt-8 border-t border-[var(--color-border)] pt-6">
        <SnsLinks />
      </div>
    </div>
  </div>
</section>

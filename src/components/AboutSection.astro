---
import { Image } from 'astro:assets';
import { siteConfig } from '../data/site';
import { ui } from '../data/ui';
import { snsLinks, type SnsLink } from '../data/sns';
import SectionHeading from './common/SectionHeading.astro';
import SnsIcon from './common/SnsIcon.astro';
import profileImg from '../assets/images/common/profile.jpg';
---

<section id="about" class="pt-10">
  <div class="flex flex-col items-center gap-10 md:flex-row md:items-start md:gap-14 lg:gap-20">
    <Image
      src={profileImg}
      alt={siteConfig.ja.author}
      class="aspect-square h-64 w-64 shrink-0 border border-border object-cover md:h-80 md:w-80 lg:h-96 lg:w-96"
    />

    <div class="w-full flex-1">
      <SectionHeading ja={ui.ja.sections.aboutTitle} en={ui.en.sections.aboutTitle} />

      <h3 class="text-2xl font-bold text-text md:text-3xl">
        <span class="lang-ja">{siteConfig.ja.author}</span>
        <span class="lang-en">{siteConfig.en.author}</span>
      </h3>

      <p class="mt-4 text-sm leading-relaxed whitespace-pre-line text-muted md:text-base">
        <span class="lang-ja">{siteConfig.ja.bio}</span>
        <span class="lang-en">{siteConfig.en.bio}</span>
      </p>

      <div class="mt-8 flex items-center justify-center gap-4 border-t border-border pt-6">
        {
          snsLinks.map((sns: SnsLink) => (
            <a
              href={sns.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={sns.name}
              title={sns.name}
              class="group flex h-12 w-12 items-center justify-center border border-muted text-muted transition-all duration-300 hover:border-accent-teal hover:bg-accent-teal hover:text-white"
            >
              <SnsIcon
                name={sns.icon}
                class="h-6 w-6 transition-transform duration-300 group-hover:scale-110"
              />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

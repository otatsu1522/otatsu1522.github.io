---
import { current } from '../data/current';
---

{
  current.active && (
    <section class="mx-auto mt-5 w-full bg-[var(--color-accent-red)] md:mt-3 md:max-w-3xl">
      <div class="flex flex-col items-center justify-center gap-1 px-4 py-3 text-[var(--color-overlay-text)] sm:px-6 md:gap-1.5 md:py-4">
        {current.date && (
          <time class="text-xs tracking-[0.1em] md:text-sm">
            <span class="lang-ja">{current.date.ja}</span>
            <span class="lang-en">{current.date.en}</span>
          </time>
        )}

        <p class="text-base font-bold tracking-[0.15em] md:text-lg">
          <span class="lang-ja">{current.title.ja}</span>
          <span class="lang-en">{current.title.en}</span>
        </p>
      </div>
    </section>
  )
}

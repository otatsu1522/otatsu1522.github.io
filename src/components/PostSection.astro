---
import { getCollection, type CollectionEntry } from 'astro:content';
import { ui } from '../data/ui';

const posts: CollectionEntry<'posts'>[] = await getCollection('posts');

const latestPosts = posts
  .sort((a, b) => {
    const dateA = a.data.date ?? '';
    const dateB = b.data.date ?? '';
    return dateB.localeCompare(dateA);
  })
  .slice(0, 3);
---

<section id="posts" class="pt-20 pb-0">
  <div class="flex items-baseline gap-2 mb-6">
    <h2 class="text-2xl font-bold text-white">
      <span class="lang-ja">{ui.ja.sections.postsTitle}</span>
      <span class="lang-en">{ui.en.sections.postsTitle}</span>
    </h2>
    <span class="lang-ja text-xs text-gray-400">{ui.ja.sections.postsSubtitle}</span>
    <span class="lang-en text-xs text-gray-400">{ui.en.sections.postsSubtitle}</span>
  </div>

  {latestPosts.length > 0 ? (
    <>
      <div class="space-y-3">
        {latestPosts.map((post) => (
          <a
            href={`/posts/${post.id}`}
            class="group block p-4 bg-slate-800/50 border border-slate-800 hover:border-slate-600 hover:bg-slate-800 transition-all"
          >
            <div class="flex flex-col">
              <div class="min-w-0">
                {post.data.date && (
                  <time class="text-xs font-mono text-gray-400 block">
                    {post.data.date}
                  </time>
                )}

                <h3 class="text-base font-bold text-white mt-1 group-hover:text-sky-300 transition-colors">
                  {post.data.title}
                </h3>

                <p class="text-sm text-gray-300 mt-1 line-clamp-2">
                  {post.data.summary}
                </p>
              </div>

              <div class="mt-4 text-xs font-medium text-slate-300 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
                <span class="lang-ja">{ui.ja.buttons.readArticle}</span>
                <span class="lang-en">{ui.en.buttons.readArticle}</span>
                <span>&rarr;</span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-6 flex justify-center">
        <a
          href="/posts/"
          class="inline-flex items-center gap-2 px-5 py-2.5 border border-slate-700 bg-slate-800/60 text-sm text-gray-300 hover:text-white hover:border-slate-500 hover:bg-slate-800 transition-all"
        >
          <span class="lang-ja">{ui.ja.buttons.viewAllPosts}</span>
          <span class="lang-en">{ui.en.buttons.viewAllPosts}</span>
        </a>
      </div>
    </>
  ) : (
    <div class="text-sm text-gray-500 py-4">
      <span class="lang-ja">{ui.ja.messages.noPosts}</span>
      <span class="lang-en">{ui.en.messages.noPosts}</span>
    </div>
  )}
</section>

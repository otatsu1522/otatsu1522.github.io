---
import { getCollection, type CollectionEntry } from 'astro:content';
import { ui } from '../data/ui';

const toDateNumber = (date?: string) => {
  if (!date) return 0;
  const match = date.trim().match(/^(\d{4})[/-](\d{1,2})[/-](\d{1,2})$/);
  if (!match) return 0;
  return Number(match[1]) * 10000 + Number(match[2]) * 100 + Number(match[3]);
};

const posts: CollectionEntry<'posts'>[] = await getCollection('posts');

const latestPosts = posts
  .filter((post) => post.data.published)
  .sort((a, b) => toDateNumber(b.data.date) - toDateNumber(a.data.date))
  .slice(0, 3);
---

<section id="posts" class="pt-20 pb-0">
  <div class="flex items-baseline gap-2 mb-6">
    <h2 class="text-2xl font-bold text-[var(--color-text)]">
      <span class="lang-ja">{ui.ja.sections.postsTitle}</span>
      <span class="lang-en">{ui.en.sections.postsTitle}</span>
    </h2>
    <span class="lang-ja text-xs text-[var(--color-muted)]">{ui.ja.sections.postsSubtitle}</span>
    <span class="lang-en text-xs text-[var(--color-muted)]">{ui.en.sections.postsSubtitle}</span>
  </div>

  {latestPosts.length > 0 ? (
    <>
      <div class="space-y-3">
        {latestPosts.map((post) => (
          <a
            href={`/posts/${post.id}`}
            class="group block p-4 bg-[var(--color-bg)] border border-[var(--color-border)] hover:border-[var(--color-text)] hover:bg-[var(--color-border)] transition-all"
          >
            <div class="flex flex-col">
              <div class="min-w-0">
                {post.data.date && post.data.showDate && (
                  <time class="text-xs font-mono text-[var(--color-muted)] block">
                    {post.data.date}
                  </time>
                )}

                <h3 class="text-base font-bold text-[var(--color-text)] mt-1 group-hover:opacity-60 transition-colors">
                  {post.data.title}
                </h3>

                <p class="text-sm text-[var(--color-muted)] mt-1 line-clamp-2">
                  {post.data.summary}
                </p>
              </div>

              <div class="mt-4 text-xs font-medium text-[var(--color-muted)] flex items-center gap-1 group-hover:text-[var(--color-text)] group-hover:translate-x-1 transition-all">
                <span class="lang-ja">{ui.ja.buttons.readArticle}</span>
                <span class="lang-en">{ui.en.buttons.readArticle}</span>
                <span>&rarr;</span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-6 flex justify-center">
        <a
          href="/posts/"
          class="inline-flex items-center gap-2 px-5 py-2.5 border border-[var(--color-border)] bg-[var(--color-bg)] text-sm text-[var(--color-muted)] hover:text-[var(--color-text)] hover:border-[var(--color-text)] hover:bg-[var(--color-border)] transition-all"
        >
          <span class="lang-ja">{ui.ja.buttons.viewAllPosts}</span>
          <span class="lang-en">{ui.en.buttons.viewAllPosts}</span>
        </a>
      </div>
    </>
  ) : (
    <div class="text-sm text-[var(--color-muted)] py-4">
      <span class="lang-ja">{ui.ja.messages.noPosts}</span>
      <span class="lang-en">{ui.en.messages.noPosts}</span>
    </div>
  )}
</section>

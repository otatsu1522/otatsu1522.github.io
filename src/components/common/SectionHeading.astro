---
interface Props {
  titleJa: string;
  titleEn: string;
  subtitleJa: string;
  subtitleEn: string;
}

const { titleJa, titleEn, subtitleJa, subtitleEn } = Astro.props;
---

<header class="section-heading">
  <div class="section-heading-title">
    <span class="lang-ja">{titleJa}</span>
    <span class="lang-en">{titleEn}</span>
  </div>

  <div class="section-heading-subtitle">
    <span class="lang-ja">{subtitleJa}</span>
    <span class="lang-en">{subtitleEn}</span>
  </div>
</header>

---
interface Props {
  ja: string;
  en: string;
  as?: 'h1' | 'h2';
  class?: string;
}

const { ja, en, as: Heading = 'h2', class: className = '' } = Astro.props;
---

<div class:list={['mb-10', className]}>
  <Heading class="text-4xl font-bold tracking-tight text-text md:text-5xl lg:text-6xl">
    <span class="lang-ja">{ja}</span>
    <span class="lang-en">{en}</span>
  </Heading>
</div>

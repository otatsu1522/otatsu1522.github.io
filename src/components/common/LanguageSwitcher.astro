---
import { defaultLanguage, languages } from '../../data/language';
---

<div class="flex items-center gap-4 text-sm tracking-widest text-white/90">
  {
    languages.map((language, index) => (
      <>
        {index > 0 && <span>/</span>}
        <button
          type="button"
          data-lang-btn={language}
          aria-pressed={language === defaultLanguage}
          class="cursor-pointer text-inherit opacity-40 transition-all duration-300"
        >
          {language.toUpperCase()}
        </button>
      </>
    ))
  }
</div>

<style is:global>
  [data-lang-btn][aria-pressed='true'] {
    opacity: 1;
    cursor: default;
    font-weight: 700;
  }

  [data-lang-btn]:not([aria-pressed='true']):hover {
    color: var(--color-accent-teal);
    opacity: 1;
  }
</style>

<script>
  import {
    isLanguage,
    languageChangedEvent,
    languageStorageKey,
    type LanguageChangedDetail,
  } from '../../data/language';

  function initLanguage(): void {
    const langButtons = document.querySelectorAll<HTMLButtonElement>('[data-lang-btn]');

    // 現在の言語(<html data-lang>)に合わせて、押されている状態を表示に反映する
    const syncPressed = () => {
      const current = document.documentElement.getAttribute('data-lang');

      langButtons.forEach((btn) => {
        btn.setAttribute('aria-pressed', String(btn.dataset.langBtn === current));
      });
    };

    langButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetLang = btn.getAttribute('data-lang-btn');

        if (!isLanguage(targetLang)) return;
        if (document.documentElement.getAttribute('data-lang') === targetLang) return;

        document.documentElement.setAttribute('data-lang', targetLang);
        document.documentElement.setAttribute('lang', targetLang);
        syncPressed();

        let persisted = true;

        try {
          localStorage.setItem(languageStorageKey, targetLang);
        } catch {
          // 保存できない環境でも、表示の切り替え自体は行う
          persisted = false;
        }

        document.dispatchEvent(
          new CustomEvent<LanguageChangedDetail>(languageChangedEvent, { detail: { persisted } }),
        );
      });
    });

    syncPressed();
  }

  initLanguage();
</script>

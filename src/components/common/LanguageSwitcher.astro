---

<div class="flex items-center gap-4 text-sm tracking-widest text-white/90">
  <button
    type="button"
    data-lang-btn="ja"
    class="cursor-pointer text-inherit opacity-40 transition-all duration-300"
  >
    JA
  </button>

  <span>/</span>

  <button
    type="button"
    data-lang-btn="en"
    class="cursor-pointer text-inherit opacity-40 transition-all duration-300"
  >
    EN
  </button>
</div>

<style is:global>
  html[data-lang='ja'] [data-lang-btn='ja'],
  html[data-lang='en'] [data-lang-btn='en'] {
    opacity: 1;
    cursor: default;
    font-weight: 700;
  }

  html[data-lang='ja'] [data-lang-btn='en']:hover,
  html[data-lang='en'] [data-lang-btn='ja']:hover {
    color: var(--color-accent-teal);
    opacity: 1;
  }
</style>

<script>
  function initLanguage(): void {
    const langButtons = document.querySelectorAll<HTMLButtonElement>('[data-lang-btn]');

    langButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetLang = btn.getAttribute('data-lang-btn');

        if (targetLang !== 'ja' && targetLang !== 'en') return;

        document.documentElement.setAttribute('data-lang', targetLang);
        document.documentElement.setAttribute('lang', targetLang);
        localStorage.setItem('preferred-lang', targetLang);
      });
    });
  }

  initLanguage();
</script>

---
import { Image } from 'astro:assets';
import postsBannerImg from '../../assets/images/common/banner.jpg';
---

<section class="pb-0 pt-10">
  <div class="relative left-1/2 w-screen -translate-x-1/2 overflow-hidden">
    <Image
      src={postsBannerImg}
      alt=""
      class="h-40 w-full object-cover object-center sm:h-48 md:h-[28rem] lg:h-[32rem]"
    />
  </div>
</section>

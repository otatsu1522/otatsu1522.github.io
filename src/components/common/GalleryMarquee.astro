---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const galleryImages = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>(
    '../../assets/images/common/*.{jpg,jpeg,png,webp,avif}',
    { eager: true },
  ),
)
  .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
  .map(([, module]) => module.default);
---

{
  galleryImages.length > 0 && (
    <div id="gallery-viewport" class="relative -ml-[calc(50vw-50%)] w-screen overflow-hidden">
      <div id="gallery-track" class="m-0 flex w-max p-0 will-change-transform">
        <div id="gallery-set" class="m-0 flex shrink-0 p-0">
          {galleryImages.map((image, index) => (
            <div class="m-0 block h-[120px] shrink-0 overflow-hidden p-0 md:h-[180px]">
              <Image
                src={image}
                alt=""
                class="m-0 block h-full w-auto max-w-none p-0"
                loading={index < 8 ? 'eager' : 'lazy'}
              />
            </div>
          ))}
        </div>

        <div class="m-0 flex shrink-0 p-0" aria-hidden="true">
          {galleryImages.map((image) => (
            <div class="m-0 block h-[120px] shrink-0 overflow-hidden p-0 md:h-[180px]">
              <Image
                src={image}
                alt=""
                class="m-0 block h-full w-auto max-w-none p-0"
                loading="lazy"
              />
            </div>
          ))}
        </div>
      </div>
    </div>
  )
}

<script>
  const GALLERY_SPEED = 50; // 横スクロール速度(px/秒)

  function setupGalleryMarquee() {
    const viewport = document.getElementById('gallery-viewport');
    const track = document.getElementById('gallery-track');
    const firstSet = document.getElementById('gallery-set');

    if (!viewport || !track || !firstSet) return;

    let position = 0;
    let previousTime = performance.now();
    let loopWidth = 0;
    let started = false;

    const updateDimensions = () => {
      loopWidth = firstSet.getBoundingClientRect().width;

      if (loopWidth > 0) {
        if (!started) {
          position = 0;
        } else {
          position %= loopWidth;

          if (position > 0) {
            position -= loopWidth;
          }
        }

        track.style.transform = `translate3d(${position}px, 0, 0)`;
      }
    };

    const animate = (time: number) => {
      const delta = time - previousTime;
      previousTime = time;

      if (loopWidth > 0) {
        position -= (GALLERY_SPEED * delta) / 1000;

        if (position <= -loopWidth) {
          position += loopWidth;
        }

        track.style.transform = `translate3d(${position}px, 0, 0)`;
      }

      requestAnimationFrame(animate);
    };

    window.addEventListener('resize', updateDimensions);

    updateDimensions();

    if (loopWidth > 0) {
      started = true;
      previousTime = performance.now();
      requestAnimationFrame(animate);
    }

    firstSet.querySelectorAll('img').forEach((image) => {
      image.addEventListener('load', updateDimensions, { once: true });
    });
  }

  setupGalleryMarquee();
</script>

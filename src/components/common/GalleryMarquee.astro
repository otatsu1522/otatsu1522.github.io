---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const galleryImages = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>(
    '../../assets/images/gallery/*.{jpg,jpeg,png,webp,avif}',
    { eager: true }
  )
)
  .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
  .map(([, module]) => module.default);

const MOBILE_HEIGHT = 120;
const DESKTOP_HEIGHT = 180;
---

{galleryImages.length > 0 && (
  <div
    id="gallery-viewport"
    class="gallery-viewport"
    style={`--gallery-mobile-height:${MOBILE_HEIGHT}px;--gallery-desktop-height:${DESKTOP_HEIGHT}px;`}
  >
    <div id="gallery-track" class="gallery-track">
      <div id="gallery-set" class="gallery-set">
        {galleryImages.map((image, index) => (
          <div class="gallery-item">
            <Image
              src={image}
              alt=""
              class="gallery-image"
              loading={index < 8 ? 'eager' : 'lazy'}
            />
          </div>
        ))}
      </div>

      <div class="gallery-set" aria-hidden="true">
        {galleryImages.map((image) => (
          <div class="gallery-item">
            <Image src={image} alt="" class="gallery-image" loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </div>
)}

<style>
  .gallery-viewport {
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    overflow: hidden;
  }

  .gallery-track {
    display: flex;
    width: max-content;
    margin: 0;
    padding: 0;
    will-change: transform;
  }

  .gallery-set {
    display: flex;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
  }

  .gallery-item {
    display: block;
    flex: 0 0 auto;
    height: var(--gallery-mobile-height);
    margin: 0;
    padding: 0;
    overflow: hidden;
  }

  .gallery-image {
    display: block;
    width: auto;
    height: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 768px) {
    .gallery-item {
      height: var(--gallery-desktop-height);
    }
  }
</style>

---
import { snsLinks, type SnsLink } from '../../data/sns';
import SnsIcon from './SnsIcon.astro';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`flex items-center justify-center gap-6 ${className}`}>
  {snsLinks.map((sns: SnsLink) => (
    <a
      href={sns.url}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={sns.name}
      title={sns.name}
      class="group px-1 text-[var(--color-muted)] transition-all duration-300 hover:-translate-y-1 hover:text-[var(--color-accent-teal)]"
    >
      <SnsIcon
        name={sns.icon}
        class="h-8 w-8 transition-transform duration-300 group-hover:scale-110"
      />
    </a>
  ))}
</div>

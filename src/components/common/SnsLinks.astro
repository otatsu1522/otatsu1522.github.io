---
import { snsLinks, type SnsLink } from '../../data/sns';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`flex items-center justify-center gap-4 ${className}`}>
  {snsLinks.map((sns: SnsLink) => (
    <a
      href={sns.url}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={sns.name}
      title={sns.name}
      class="w-10 h-10 border border-slate-700 bg-slate-900/50 flex items-center justify-center text-gray-400 hover:text-white hover:border-slate-500 hover:bg-slate-800 transition-all"
    >
      {sns.icon === 'youtube' && (
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.5v-7L15.8 12l-6.2 3.5Z" />
        </svg>
      )}

      {sns.icon === 'instagram' && (
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none" />
        </svg>
      )}

      {sns.icon === 'twitter' && (
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M18.9 2H22l-6.8 7.8L23.2 22h-6.3l-4.9-6.4L6.4 22H3.3l7.3-8.4L2.8 2h6.4l4.4 5.9L18.9 2Zm-1.1 17.9h1.7L8.3 3.9H6.5l11.3 16Z" />
        </svg>
      )}

      {sns.icon === 'tiktok' && (
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M14.5 3c.3 1.7 1.2 3.1 2.8 4.1 1 .6 2 .9 3.2 1v3.2c-1.2 0-2.3-.3-3.3-.8v6.8c0 4-2.8 6.3-6.4 6.3-3.3 0-5.8-2.3-5.8-5.6 0-3.5 2.7-5.8 6.2-5.8.3 0 .7 0 1 .1v3.2c-.3-.1-.6-.1-.9-.1-1.5 0-2.7 1-2.7 2.5 0 1.4 1.1 2.4 2.4 2.4 1.5 0 2.4-.9 2.4-2.7V3h3.1Z" />
        </svg>
      )}
    </a>
  ))}
</div>

---
import { snsLinks, type SnsLink } from '../../data/sns';
import SnsIcon from './SnsIcon.astro';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`flex items-center justify-center gap-4 ${className}`}>
  {snsLinks.map((sns: SnsLink) => (
    <a
      href={sns.url}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={sns.name}
      title={sns.name}
      class="w-10 h-10 border border-[var(--color-border)] bg-[var(--color-bg)] flex items-center justify-center text-[var(--color-muted)] hover:text-[var(--color-text)] hover:border-[var(--color-text)] hover:bg-[var(--color-border)] transition-all"
    >
      <SnsIcon name={sns.icon} />
    </a>
  ))}
</div>

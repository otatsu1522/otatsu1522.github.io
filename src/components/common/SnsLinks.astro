---
import { snsLinks, type SnsLink } from '../../data/sns';
import SnsIcon from './SnsIcon.astro';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`flex items-center justify-center gap-4 ${className}`}>
  {
    snsLinks.map((sns: SnsLink) => (
      <a
        href={sns.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={sns.name}
        title={sns.name}
        class="group flex h-12 w-12 items-center justify-center border border-[var(--color-muted)] text-[var(--color-muted)] transition-all duration-300 hover:border-[var(--color-accent-teal)] hover:bg-[var(--color-accent-teal)] hover:text-white"
      >
        <SnsIcon
          name={sns.icon}
          class="h-6 w-6 transition-transform duration-300 group-hover:scale-110"
        />
      </a>
    ))
  }
</div>

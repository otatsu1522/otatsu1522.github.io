---
const showPageIndicator = Astro.url.pathname === '/';
---

{showPageIndicator && (
  <div id="big-bang-container" class="opacity-0 pointer-events-none">
    <div id="big-bang-effect" aria-hidden="true">
      <canvas id="big-bang-canvas"></canvas>
    </div>

    <button
      id="big-bang-trigger"
      type="button"
      class="fixed bottom-6 left-6 z-40 text-xs font-mono text-gray-400 hover:text-white transition-colors tracking-widest cursor-pointer disabled:opacity-60 disabled:cursor-default"
    >
      BOM
    </button>
  </div>
)}

<style is:global>
  #big-bang-container {
    transition: opacity 0.5s ease;
  }

  #big-bang-effect {
    position: fixed;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
  }

  #big-bang-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>

<script>
  const DURATION = 5000;
  const PARTICLE_COUNT = 1000;

  type Particle = {
    angle: number;
    distance: number;
    speed: number;
    size: number;
    opacity: number;
    delay: number;
    life: number;
    driftX: number;
    driftY: number;
    rotation: number;
    color: string;
  };

  let running = false;
  let animationFrame = 0;

  const random = (min: number, max: number) => Math.random() * (max - min) + min;

  const randomColor = (): string => {
    const hue = random(0, 55);
    const saturation = random(85, 100);
    const lightness = random(50, 70);
    return `hsl(${hue} ${saturation}% ${lightness}%)`;
  };

  function initBigBang() {
    const container = document.getElementById('big-bang-container');
    const canvas = document.getElementById('big-bang-canvas') as HTMLCanvasElement | null;
    const button = document.getElementById('big-bang-trigger') as HTMLButtonElement | null;

    if (!container || !canvas || !button) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const updateVisibility = () => {
      const sections = document.querySelectorAll<HTMLElement>('main > section');
      const lastSection = sections[sections.length - 1];

      if (!lastSection) return;

      const secondPage = window.scrollY >= window.innerHeight;

      if (!secondPage) {
        container.style.opacity = '0';
        container.style.pointerEvents = 'none';
        return;
      }

      const rect = lastSection.getBoundingClientRect();
      const fadeStart = window.innerHeight * 0.5;
      const progress = Math.max(
        0,
        Math.min(
          1,
          (window.innerHeight - rect.bottom) / fadeStart
        )
      );

      container.style.opacity = String(1 - progress);
      container.style.pointerEvents = progress >= 1 ? 'none' : 'auto';
    };

    const resize = () => {
      const dpr = window.devicePixelRatio || 1;
      canvas.width = window.innerWidth * dpr;
      canvas.height = window.innerHeight * dpr;
      canvas.style.width = `${window.innerWidth}px`;
      canvas.style.height = `${window.innerHeight}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const createParticles = (): Particle[] => {
      return Array.from({ length: PARTICLE_COUNT }, () => {
        const angle = random(0, Math.PI * 2);
        return {
          angle,
          distance: random(350, Math.max(window.innerWidth, window.innerHeight) * 1.3),
          speed: random(0.7, 1.7),
          size: random(1, 7),
          opacity: random(0.45, 1),
          delay: random(0, 0.12),
          life: random(0.75, 1),
          driftX: random(-90, 90),
          driftY: random(-90, 90),
          rotation: random(-1, 1),
          color: randomColor(),
        };
      });
    };

    const drawGlow = (x: number, y: number, radius: number, alpha: number) => {
      const safeRadius = Math.max(radius, 0.001);
      const gradient = ctx.createRadialGradient(x, y, 0, x, y, safeRadius);
      gradient.addColorStop(0, `rgba(255,255,255,${alpha})`);
      gradient.addColorStop(0.15, `rgba(255,250,220,${alpha * 0.8})`);
      gradient.addColorStop(0.4, `rgba(255,225,120,${alpha * 0.45})`);
      gradient.addColorStop(1, 'rgba(255,220,80,0)');

      ctx.fillStyle = gradient;
      ctx.beginPath();
      ctx.arc(x, y, safeRadius, 0, Math.PI * 2);
      ctx.fill();
    };

    const drawParticle = (particle: Particle, elapsed: number, centerX: number, centerY: number) => {
      const localTime = (elapsed - particle.delay * DURATION) / (DURATION * particle.life);
      if (localTime <= 0 || localTime >= 1) return;

      const progress = 1 - Math.pow(1 - localTime, 3);
      const wobble = Math.sin(localTime * 18 + particle.rotation * 10) * 0.08;
      const angle = particle.angle + wobble;
      const distance = particle.distance * progress * particle.speed;
      const x = centerX + Math.cos(angle) * distance + particle.driftX * localTime * localTime;
      const y = centerY + Math.sin(angle) * distance + particle.driftY * localTime * localTime;

      const fadeIn = Math.min(localTime / 0.08, 1);
      const fadeOut = Math.min((1 - localTime) / 0.18, 1);
      const alpha = particle.opacity * fadeIn * fadeOut;
      const size = particle.size * (1 + progress * random(0.2, 0.8));

      ctx.save();
      ctx.globalAlpha = alpha;
      ctx.fillStyle = particle.color;
      ctx.beginPath();
      ctx.arc(x, y, size, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    };

    const start = () => {
      if (running) return;
      running = true;
      button.disabled = true;

      const startedAt = performance.now();
      const particles = createParticles();

      const render = (now: number) => {
        const elapsed = now - startedAt;
        const progress = Math.min(elapsed / DURATION, 1);
        const centerX = window.innerWidth / 2;
        const centerY = window.innerHeight / 2;

        ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);

        const flashProgress = Math.min(progress / 0.18, 1);
        const flashFade = Math.pow(1 - progress, 2);

        if (flashProgress < 1) {
          drawGlow(centerX, centerY, Math.max(window.innerWidth, window.innerHeight) * (0.04 + flashProgress * 0.35), 0.95 * flashFade);
        }

        if (progress < 0.32) {
          const shockProgress = progress / 0.32;
          drawGlow(centerX, centerY, Math.max(window.innerWidth, window.innerHeight) * shockProgress * 0.8, 0.35 * (1 - shockProgress));
        }

        for (const particle of particles) {
          drawParticle(particle, elapsed, centerX, centerY);
        }

        if (progress < 1) {
          animationFrame = requestAnimationFrame(render);
          return;
        }

        cancelAnimationFrame(animationFrame);
        ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
        running = false;
        button.disabled = false;
      };

      animationFrame = requestAnimationFrame(render);
    };

    resize();
    updateVisibility();

    window.addEventListener('resize', resize, { passive: true });
    window.addEventListener('scroll', updateVisibility, { passive: true });
    button.addEventListener('click', start);
  }

  document.addEventListener('DOMContentLoaded', initBigBang);
  document.addEventListener('astro:page-load', initBigBang);
  document.addEventListener('astro:after-swap', initBigBang);
</script>

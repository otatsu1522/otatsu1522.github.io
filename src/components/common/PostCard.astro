---
import type { HTMLAttributes } from 'astro/types';
import type { CollectionEntry } from 'astro:content';
import { routes } from '../../data/routes';
import { toIsoDate } from '../../utils/date';

interface Props extends Omit<HTMLAttributes<'a'>, 'href'> {
  entry: CollectionEntry<'posts'>;
  headingLevel?: 'h2' | 'h3';
}

const { entry, headingLevel = 'h3', class: className, ...rest } = Astro.props;
const Heading = headingLevel;
---

<a
  {...rest}
  href={`${routes.posts}${entry.id}/`}
  class:list={[
    'group block border-b border-border py-5 transition-all duration-300 first:pt-0 last:border-b-0 hover:px-2 md:py-6 md:first:pt-0',
    className,
  ]}
>
  <div class="min-w-0">
    <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
      {
        entry.data.date && entry.data.showDate && (
          <time
            datetime={toIsoDate(entry.data.date)}
            class="text-[10px] tracking-[0.14em] text-muted"
          >
            {entry.data.date}
          </time>
        )
      }

      <span class="h-px w-5 bg-accent-teal transition-all duration-300 group-hover:w-8"></span>
    </div>

    <Heading
      class="mt-2 text-lg leading-tight font-semibold tracking-tight text-text transition-colors duration-300 group-hover:text-accent-teal md:text-xl"
    >
      {entry.data.title}
    </Heading>

    <p class="mt-2 line-clamp-2 max-w-3xl text-sm leading-relaxed text-muted">
      {entry.data.summary}
    </p>
  </div>
</a>

---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface NavigationEntry {
  id: string;
  data: {
    title: string;
    date?: string;
    showDate?: boolean;
    cover?: ImageMetadata;
  };
}

interface Props {
  previous?: NavigationEntry;
  next?: NavigationEntry;
  basePath: string;
}

const { previous, next, basePath } = Astro.props;
---

{
  (previous || next) && (
    <nav
      class="mx-auto mt-16 max-w-3xl border-t border-[var(--color-border)] pt-8"
      aria-label="Article navigation"
    >
      <div class="grid grid-cols-2 gap-6">
        {previous ? (
          <a href={`${basePath}/${previous.id}`} class="group min-w-0">
            <div class="text-xs tracking-[0.16em] text-[var(--color-muted)]">
              <span class="lang-ja">前の記事</span>
              <span class="lang-en">PREVIOUS</span>
            </div>

            <div class="mt-4">
              {previous.data.cover && (
                <div class="mb-5 w-1/2 overflow-hidden">
                  <Image
                    src={previous.data.cover}
                    alt={previous.data.title}
                    class="aspect-[4/3] h-auto w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                  />
                </div>
              )}

              <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
                {previous.data.date && previous.data.showDate && (
                  <time class="text-[10px] tracking-[0.14em] text-[var(--color-muted)]">
                    {previous.data.date}
                  </time>
                )}

                <span class="h-px w-5 bg-[var(--color-accent-teal)] transition-all duration-300 group-hover:w-8" />
              </div>

              <div class="mt-2 text-xs leading-tight font-semibold tracking-tight text-[var(--color-text)] transition-colors duration-300 group-hover:text-[var(--color-accent-teal)] md:text-xl">
                {previous.data.title}
              </div>
            </div>
          </a>
        ) : (
          <div />
        )}

        {next && (
          <a href={`${basePath}/${next.id}`} class="group min-w-0 text-right">
            <div class="text-xs tracking-[0.16em] text-[var(--color-muted)]">
              <span class="lang-ja">次の記事</span>
              <span class="lang-en">NEXT</span>
            </div>

            <div class="mt-4">
              {next.data.cover && (
                <div class="mb-5 ml-auto w-1/2 overflow-hidden">
                  <Image
                    src={next.data.cover}
                    alt={next.data.title}
                    class="aspect-[4/3] h-auto w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                  />
                </div>
              )}

              <div class="flex flex-wrap items-center justify-end gap-x-4 gap-y-1">
                {next.data.date && next.data.showDate && (
                  <time class="text-[10px] tracking-[0.14em] text-[var(--color-muted)]">
                    {next.data.date}
                  </time>
                )}

                <span class="h-px w-5 bg-[var(--color-accent-teal)] transition-all duration-300 group-hover:w-8" />
              </div>

              <div class="mt-2 text-xs leading-tight font-semibold tracking-tight text-[var(--color-text)] transition-colors duration-300 group-hover:text-[var(--color-accent-teal)] md:text-xl">
                {next.data.title}
              </div>
            </div>
          </a>
        )}
      </div>
    </nav>
  )
}

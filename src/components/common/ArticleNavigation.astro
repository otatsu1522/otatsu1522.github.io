---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ui } from '../../data/ui';

interface NavigationEntry {
  id: string;
  data: {
    title: string;
    date?: string;
    showDate?: boolean;
    cover?: ImageMetadata;
  };
}

interface Props {
  previous?: NavigationEntry;
  next?: NavigationEntry;
  basePath: string;
}

const { previous, next, basePath } = Astro.props;

const links = [
  {
    entry: previous,
    isNext: false,
    label: { ja: ui.ja.article.previous, en: ui.en.article.previous },
  },
  { entry: next, isNext: true, label: { ja: ui.ja.article.next, en: ui.en.article.next } },
];
---

{
  (previous || next) && (
    <nav
      class="mx-auto mt-16 max-w-3xl border-t border-border pt-8"
      aria-label="Article navigation"
    >
      <div class="grid grid-cols-2 gap-6">
        {links.map(({ entry, isNext, label }) =>
          entry ? (
            <a
              href={`${basePath}/${entry.id}/`}
              class:list={['group min-w-0', isNext && 'text-right']}
            >
              <div class="text-xs tracking-[0.16em] text-muted">
                <span class="lang-ja">{label.ja}</span>
                <span class="lang-en">{label.en}</span>
              </div>

              <div class="mt-4">
                {entry.data.cover && (
                  <div class:list={['mb-5 w-1/2 overflow-hidden', isNext && 'ml-auto']}>
                    <Image
                      src={entry.data.cover}
                      alt={entry.data.title}
                      class="aspect-[4/3] h-auto w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                    />
                  </div>
                )}

                <div
                  class:list={[
                    'flex flex-wrap items-center gap-x-4 gap-y-1',
                    isNext && 'justify-end',
                  ]}
                >
                  {entry.data.date && entry.data.showDate && (
                    <time class="text-[10px] tracking-[0.14em] text-muted">{entry.data.date}</time>
                  )}

                  <span class="h-px w-5 bg-accent-teal transition-all duration-300 group-hover:w-8" />
                </div>

                <div class="mt-2 text-xs leading-tight font-semibold tracking-tight text-text transition-colors duration-300 group-hover:text-accent-teal md:text-xl">
                  {entry.data.title}
                </div>
              </div>
            </a>
          ) : (
            <div />
          ),
        )}
      </div>
    </nav>
  )
}

---
const showPageIndicator = Astro.url.pathname === '/';
---

{showPageIndicator && (
  <div
    id="page-indicator"
    class="fixed bottom-6 right-6 z-40 text-xs font-mono text-gray-400 pointer-events-none select-none tracking-widest"
    style="visibility:hidden;"
  >
    <span id="current-page">01</span>/<span id="total-pages">01</span>
  </div>
)}

<style is:global>
  #page-indicator {
    isolation: isolate;
  }

  #page-indicator::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 90px;
    height: 44px;
    transform: translate(-50%, -50%);
    z-index: -1;
    pointer-events: none;
    border-radius: 50%;
    background: radial-gradient(
      ellipse at center,
      rgb(0 0 0 / var(--page-background-opacity, 0)) 0%,
      rgb(0 0 0 / calc(var(--page-background-opacity, 0) * 0.8)) 35%,
      rgb(0 0 0 / calc(var(--page-background-opacity, 0) * 0.4)) 55%,
      rgb(0 0 0 / 0) 100%
    );
    filter: blur(8px);
  }
</style>

<script>
  let cleanupHandler: (() => void) | null = null;

  function setupPageIndicator() {
    const sections = Array.from(
      document.querySelectorAll<HTMLElement>('section')
    ).filter((section) => section.id !== 'playlist');

    const fadeSections = document.querySelectorAll<HTMLElement>('main > section');
    const lastSection = fadeSections[fadeSections.length - 1];

    const currentEl = document.getElementById('current-page');
    const totalEl = document.getElementById('total-pages');
    const indicator = document.getElementById('page-indicator');

    if (!sections.length || !lastSection || !currentEl || !totalEl || !indicator) return;

    if (cleanupHandler) {
      cleanupHandler();
    }

    totalEl.textContent = String(sections.length).padStart(2, '0');

    let ticking = false;

    const updateCurrentPage = () => {
      const viewportCenter = window.scrollY + window.innerHeight / 2;

      let closestIndex = 0;
      let closestDistance = Infinity;

      sections.forEach((section, index) => {
        const rect = section.getBoundingClientRect();
        const sectionCenter = window.scrollY + rect.top + rect.height / 2;
        const distance = Math.abs(sectionCenter - viewportCenter);

        if (distance < closestDistance) {
          closestDistance = distance;
          closestIndex = index;
        }
      });

      currentEl.textContent = String(closestIndex + 1).padStart(2, '0');

      const rect = lastSection.getBoundingClientRect();
      const fadeStart = window.innerHeight * 0.5;

      const exitProgress = Math.max(
        0,
        Math.min(
          1,
          (window.innerHeight - rect.bottom) / fadeStart
        )
      );

      const indicatorOpacity = 1 - exitProgress;

      indicator.style.opacity = String(indicatorOpacity);

      const backgroundOpacity = Math.min(
        (window.scrollY / window.innerHeight) * 0.75,
        0.75
      ) * indicatorOpacity;

      indicator.style.setProperty(
        '--page-background-opacity',
        String(backgroundOpacity)
      );

      ticking = false;
    };

    const requestUpdate = () => {
      if (ticking) return;

      ticking = true;
      requestAnimationFrame(updateCurrentPage);
    };

    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate);

    cleanupHandler = () => {
      window.removeEventListener('scroll', requestUpdate);
      window.removeEventListener('resize', requestUpdate);
      cleanupHandler = null;
    };

    updateCurrentPage();
    indicator.style.visibility = 'visible';
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupPageIndicator, { once: true });
  } else {
    setupPageIndicator();
  }

  document.addEventListener('astro:after-swap', setupPageIndicator);
</script>

---
import { Image } from 'astro:assets';
import type { HTMLAttributes } from 'astro/types';
import type { CollectionEntry } from 'astro:content';
import { ui } from '../../data/ui';
import { routes } from '../../data/routes';
import { toIsoDate } from '../../utils/date';

interface Props extends Omit<HTMLAttributes<'a'>, 'href'> {
  entry: CollectionEntry<'journeys'>;
  headingLevel?: 'h2' | 'h3';
}

const { entry, headingLevel = 'h3', class: className, ...rest } = Astro.props;
const Heading = headingLevel;
---

<a
  {...rest}
  href={`${routes.journeys}${entry.id}/`}
  class:list={['group/card flex flex-col', className]}
>
  {
    entry.data.cover && (
      <div class="aspect-4/3 w-full shrink-0 overflow-hidden bg-border">
        <Image
          src={entry.data.cover}
          alt=""
          sizes="(min-width: 1024px) 30vw, (min-width: 768px) 45vw, 80vw"
          class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover/card:scale-105"
        />
      </div>
    )
  }

  <div class="pt-5">
    {
      entry.data.date && entry.data.showDate && (
        <time
          datetime={toIsoDate(entry.data.date)}
          class="block text-[10px] tracking-[0.2em] text-muted"
        >
          {entry.data.date}
        </time>
      )
    }

    <div class="mt-3 h-px w-10 bg-accent-teal transition-all duration-500 group-hover/card:w-16">
    </div>

    <Heading
      class="mt-4 text-xl leading-tight font-bold tracking-tight text-text transition-colors duration-300 group-hover/card:text-accent-teal lg:text-2xl"
    >
      {entry.data.title}
    </Heading>

    <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-muted md:text-base">
      {entry.data.summary}
    </p>

    <div class="mt-6">
      <span
        class="relative inline-block pb-1 text-xs font-bold tracking-[0.16em] text-text transition-all duration-300 group-hover/card:translate-x-1.5 group-hover/card:text-accent-teal after:absolute after:bottom-0 after:left-0 after:h-px after:w-6 after:bg-text after:transition-all after:duration-300 group-hover/card:after:w-full group-hover/card:after:bg-accent-teal"
      >
        <span class="lang-ja">{ui.ja.buttons.readArticle}</span>
        <span class="lang-en">{ui.en.buttons.readArticle}</span>
      </span>
    </div>
  </div>
</a>

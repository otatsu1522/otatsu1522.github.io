---
// 常時ループする横スクロールギャラリー（操作ボタン無し、常時自動再生のみ）。
// src/assets/images/gallery/<dir>/ に画像を置くだけで自動的に読み込まれ、枚数の上限は無い。
// 日本一周・世界一周など、複数のギャラリーで使い回せるよう dir で対象フォルダを切り替える。
//
// 【実装メモ】import.meta.glob のパスは静的解析が必要なため、
// dir をパス文字列の中に直接埋め込むことはできない。
// そのため常に全ギャラリーフォルダをglobしておき、dir に応じてJS側でフィルタする。
import { Image } from 'astro:assets';
import Bilingual from './Bilingual.astro';

interface Props {
  /** src/assets/images/gallery/ 配下のフォルダ名 (例: 'japan' | 'world') */
  dir: string;
  /** ファイル名をキーにしたキャプション（無くても表示は可能） */
  captions?: Record<string, { ja: string; en: string }>;
}

const { dir, captions = {} } = Astro.props;

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/gallery/*/*.{jpg,jpeg,png,webp}',
  { eager: true }
);

const images = Object.keys(imageModules)
  .filter((path) => path.includes(`/gallery/${dir}/`))
  .sort()
  .map((path) => {
    const filename = path.split('/').pop() ?? '';
    return {
      src: imageModules[path].default,
      filename,
      caption: captions[filename],
    };
  });
---

{images.length > 0 && (
  /* 親要素の max-w に関係なく画面幅いっぱいまで広げる（fullbleed）ことで、
     画像が「画面の端」で現れて「画面の端」に消えていくようにする。
     固定の表示領域(overflow-hidden の箱)は最小限にし、幅は100vw。 */
  <div class="gallery-strip w-screen relative left-1/2 -translate-x-1/2 overflow-hidden">
    <div class="gallery-track flex will-change-transform">
      {/* 継続ループのため画像セットを2つ並べる（片方が画面外に出た瞬間、
          もう片方の同じ画像が入れ替わるので繋ぎ目が見えない） */}
      {[...images, ...images].map((image, index) => (
        <figure class="shrink-0 px-1" aria-hidden={index >= images.length}>
          <Image
            src={image.src}
            alt={image.caption?.ja ?? ''}
            height={320}
            class="h-48 md:h-64 w-auto object-contain"
          />
          {image.caption && (
            <figcaption class="mt-1 text-center text-[11px] font-mono text-neutral-500">
              <Bilingual ja={image.caption.ja} en={image.caption.en} />
            </figcaption>
          )}
        </figure>
      ))}
    </div>
  </div>
)}

<script>
  // このページに複数のギャラリー(.gallery-strip)が存在しうるため、
  // それぞれを独立してループさせる。
  document.querySelectorAll<HTMLElement>('.gallery-strip').forEach((strip) => {
    const track = strip.querySelector<HTMLElement>('.gallery-track');
    if (!track) return;

    const SPEED_PX_PER_FRAME = 0.6;
    let offset = 0;

    function tick() {
      const loopWidth = track!.scrollWidth / 2; // 画像を2セット並べているので半分が1周分
      if (loopWidth > 0) {
        offset = (offset + SPEED_PX_PER_FRAME) % loopWidth;
        track!.style.transform = `translateX(${-offset}px)`;
      }
      requestAnimationFrame(tick);
    }

    requestAnimationFrame(tick);
  });
</script>

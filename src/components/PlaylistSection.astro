---
import { Image } from 'astro:assets';
import { recommendedPlaylists, type Playlist } from '../data/recommend';
import { ui } from '../data/ui';
import SectionHeading from './common/SectionHeading.astro';

const playlists = recommendedPlaylists.filter((item): item is Playlist => item.type === 'playlist');
---

{
  playlists.length > 0 && (
    <section id="playlist" class="pt-10">
      <SectionHeading ja={ui.ja.sections.playlistTitle} en={ui.en.sections.playlistTitle} />

      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {playlists.map((item) => (
          <a
            href={item.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group relative block overflow-hidden"
          >
            <div class="aspect-16/10 overflow-hidden bg-border">
              <Image
                src={item.image}
                alt=""
                sizes="(min-width: 768px) 33vw, 100vw"
                class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
              />

              <div class="absolute inset-0 bg-black/35 transition-colors duration-500 group-hover:bg-black/20" />

              <div class="absolute inset-x-0 bottom-0 p-6 md:p-8">
                <div class="h-px w-8 bg-white transition-all duration-300 group-hover:w-14" />

                <h3 class="mt-4 text-2xl font-bold tracking-tight text-white md:text-3xl">
                  <span class="lang-ja">{item.title.ja}</span>
                  <span class="lang-en">{item.title.en}</span>
                </h3>

                <span class="mt-3 inline-block text-xs font-semibold tracking-[0.18em] text-white/80 transition-colors duration-300 group-hover:text-white">
                  <span class="lang-ja">{ui.ja.labels.youtubePlaylist}</span>
                  <span class="lang-en">{ui.en.labels.youtubePlaylist}</span>
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
  )
}

---
import { getCollection, type CollectionEntry } from 'astro:content';
import JourneyCard from './common/JourneyCard.astro';
import { ui } from '../data/ui';

const toDateNumber = (date?: string) => {
  if (!date) return 0;
  const match = date.trim().match(/^(\d{4})[/-](\d{1,2})[/-](\d{1,2})$/);
  if (!match) return 0;
  return Number(match[1]) * 10000 + Number(match[2]) * 100 + Number(match[3]);
};

const journeys: CollectionEntry<'journeys'>[] = (await getCollection('journeys'))
  .filter((entry) => entry.data.published)
  .sort((a, b) => toDateNumber(b.data.date) - toDateNumber(a.data.date));

const carouselItemClass =
  'w-[80vw] max-w-[80vw] shrink-0 snap-center md:w-[calc((100%_-_3rem)/3)] md:max-w-none md:snap-start';
---

<section id="featured" class="pt-20 pb-0">
  <div class="mb-10 text-left md:text-center">
    <h2 class="text-4xl font-bold tracking-tight text-[var(--color-text)] md:text-5xl lg:text-6xl">
      <span class="lang-ja">{ui.ja.sections.journeyTitle}</span>
      <span class="lang-en">{ui.en.sections.journeyTitle}</span>
    </h2>
  </div>

  {journeys.length > 0 ? (
    <div class="relative">
      <div
        id="journey-container"
        class="-mx-4 flex w-[calc(100%+2rem)] snap-x snap-mandatory gap-4 overflow-x-auto px-[10vw] pb-4 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden md:relative md:left-1/2 md:-translate-x-1/2 md:w-[calc(100vw-8rem)] md:mx-0 md:gap-6 md:px-0"
      >
        {journeys.map((item) => (
          <JourneyCard entry={item} class={carouselItemClass} />
        ))}
      </div>

      <div class="mt-5 flex justify-center">
        <a
          href="/journeys/"
          class="inline-block text-4xl font-bold tracking-[0.16em] text-[var(--color-accent-green)] transition-all duration-300 hover:text-[var(--color-accent-teal)] hover:-translate-y-1 md:text-5xl"
        >
          MORE
        </a>
      </div>
    </div>
  ) : (
    <div class="py-4 text-sm text-[var(--color-muted)]">
      <span class="lang-ja">{ui.ja.messages.noJourneys}</span>
      <span class="lang-en">{ui.en.messages.noJourneys}</span>
    </div>
  )}
</section>

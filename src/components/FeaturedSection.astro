---
import JourneyCard from './common/JourneyCard.astro';
import SectionHeading from './common/SectionHeading.astro';
import MoreLink from './common/MoreLink.astro';
import { ui } from '../data/ui';
import { routes } from '../data/routes';
import { getPublishedEntries } from '../utils/content';

const journeys = await getPublishedEntries('journeys');

const carouselItemClass =
  'w-[80vw] max-w-[80vw] shrink-0 snap-center md:w-[calc((100%_-_3rem)/3)] md:max-w-none md:snap-start';
---

<section id="featured" class="pt-10">
  <SectionHeading
    ja={ui.ja.sections.journeyTitle}
    en={ui.en.sections.journeyTitle}
    class="text-left md:text-center"
  />

  {
    journeys.length > 0 ? (
      <div class="relative">
        <div
          id="featured-container"
          class="-mx-4 flex w-[calc(100%+2rem)] snap-x snap-mandatory [scrollbar-width:none] gap-4 overflow-x-auto px-[10vw] pb-4 [-ms-overflow-style:none] md:relative md:left-1/2 md:mx-0 md:w-[calc(100vw-8rem)] md:-translate-x-1/2 md:gap-6 md:px-0 [&::-webkit-scrollbar]:hidden"
        >
          {journeys.map((item) => (
            <JourneyCard entry={item} class={carouselItemClass} />
          ))}
        </div>

        <div class="mt-5 flex justify-center">
          <MoreLink href={routes.journeys} />
        </div>
      </div>
    ) : (
      <div class="py-4 text-sm text-muted">
        <span class="lang-ja">{ui.ja.messages.noJourneys}</span>
        <span class="lang-en">{ui.en.messages.noJourneys}</span>
      </div>
    )
  }
</section>

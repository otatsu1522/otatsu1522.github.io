---
import LanguageSwitcher from '../components/common/LanguageSwitcher.astro';
import { navigationItems } from '../data/navigation';
import { ui } from '../data/ui';
---

<button
  id="menu-toggle"
  type="button"
  aria-label={ui.ja.buttons.toggleMenu}
  aria-expanded="false"
  aria-controls="menu-overlay"
  class="group fixed top-5 right-5 z-[100] flex h-12 w-12 cursor-pointer flex-col items-center justify-center gap-[7px] bg-transparent md:top-6 md:right-6 md:h-14 md:w-14"
>
  <span
    class="menu-line block h-[3px] w-7 bg-[var(--color-accent-red)] transition-colors duration-300 ease-out group-hover:bg-[var(--color-accent-teal)] md:w-8"
  ></span>
  <span
    class="menu-line block h-[3px] w-7 bg-[var(--color-accent-orange)] transition-colors duration-300 ease-out group-hover:bg-[var(--color-accent-green)] md:w-8"
  ></span>
</button>

<div
  id="menu-overlay"
  class="pointer-events-none fixed inset-0 z-[90] flex h-[100dvh] w-[100dvw] max-w-[100dvw] translate-x-full flex-col items-center justify-center overflow-hidden bg-[var(--color-overlay-bg)] text-[var(--color-overlay-text)] opacity-0 transition-[transform,opacity] duration-300 ease-in-out"
  aria-hidden="true"
>
  <nav class="flex translate-y-4 flex-col items-center gap-3 text-center md:translate-y-6 md:gap-4">
    {
      navigationItems.map((item) => (
        <a
          href={item.href}
          class="menu-link text-[clamp(1.8rem,6vh,3rem)] leading-[0.95] font-bold tracking-tight text-white/90 transition-colors duration-300 hover:text-[var(--color-accent-teal)] md:text-[clamp(2rem,8vh,4rem)]"
        >
          <span class="lang-ja">{ui.ja.nav[item.key]}</span>
          <span class="lang-en">{ui.en.nav[item.key]}</span>
        </a>
      ))
    }
  </nav>

  <div class="mt-16 flex items-center gap-4 text-sm tracking-widest text-white/50 md:mt-18">
    <LanguageSwitcher />
  </div>
</div>

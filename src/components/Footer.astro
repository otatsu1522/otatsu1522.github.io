---
import { navigationItems, type NavItem } from '../data/navigation';
import { ui } from '../data/ui';
import SnsLinks from './common/SnsLinks.astro';

const currentYear = new Date().getFullYear();
---

<footer class="mt-20 bg-[var(--color-overlay-bg)] text-[var(--color-overlay-text)]">
  <div class="mx-auto flex max-w-5xl flex-col items-center px-4 py-12 md:py-16">
    <a
      href="#top"
      id="footer-scroll-top"
      class="group flex flex-col items-center text-white/50 transition-colors duration-300 hover:text-[var(--color-accent-teal)]"
      aria-label={ui.ja.footer.scrollTop}
    >
      <svg
        class="h-5 w-5 transition-transform duration-300 group-hover:-translate-y-1"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.5"
          d="M5 15l7-7 7 7"
        />
      </svg>

      <span class="mt-2 text-[10px] font-mono tracking-[0.18em]">
        {ui.ja.footer.scrollTop}
      </span>
    </a>

    <nav class="mt-6 w-full py-6">
      <ul class="flex flex-wrap items-center justify-center gap-x-7 gap-y-4 md:gap-x-10">
        {navigationItems.map((item: NavItem) => (
          <li>
            <a
              href={item.href}
              class="text-xs font-medium tracking-[0.14em] text-white/50 transition-colors duration-300 hover:text-[var(--color-accent-teal)]"
            >
              <span class="lang-ja">{ui.ja.nav[item.key]}</span>
              <span class="lang-en">{ui.en.nav[item.key]}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="mt-4">
      <SnsLinks />
    </div>

    <p class="mt-8 text-[10px] font-mono tracking-[0.12em] text-white/40">
      &copy; {currentYear} {ui.ja.footer.copyRights}
    </p>
  </div>
</footer>

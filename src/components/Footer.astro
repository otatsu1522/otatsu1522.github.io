---
import { navigationItems, type NavItem } from '../data/navigation';
import { ui } from '../data/ui';
import SnsLinks from './common/SnsLinks.astro';

const currentYear = new Date().getFullYear();
---

<footer class="pt-24 pb-6 bg-gradient-to-b from-transparent via-black/85 to-sky-800/85 text-center relative">
  <div class="max-w-5xl mx-auto px-4 flex flex-col items-center justify-center">

    <a
      href="#top"
      id="footer-scroll-top"
      class="group flex flex-col items-center text-gray-400 hover:text-white transition-colors"
      aria-label={ui.ja.footer.scrollTop}
    >
      <svg
        class="w-5 h-5 group-hover:-translate-y-1 transition-transform"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M5 15l7-7 7 7"
        ></path>
      </svg>

      <span class="text-[10px] font-mono tracking-widest mt-2">
        <span>{ui.ja.footer.scrollTop}</span>
      </span>
    </a>

    <SnsLinks class="mt-24" />

    <p class="text-xs font-mono text-gray-400 mt-10">
      <span>&copy; {currentYear} {ui.ja.footer.copyRights}</span>
    </p>

  </div>
</footer>

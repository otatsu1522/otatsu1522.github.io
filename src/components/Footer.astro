---
import { navigationItems, type NavItem } from '../data/navigation';
import { ui } from '../data/ui';
import SnsLinks from './common/SnsLinks.astro';

const currentYear = new Date().getFullYear();
---

<footer class="pt-24 pb-16 bg-gradient-to-b from-slate-950 via-black to-black text-center relative">
  <div class="max-w-5xl mx-auto px-4 flex flex-col items-center justify-center">

    <a
      href="#top"
      class="group flex flex-col items-center text-gray-500 hover:text-white transition-colors"
      aria-label={ui.ja.footer.scrollTop}
    >
      <span class="text-xl leading-none group-hover:-translate-y-1 transition-transform">
        &uarr;
      </span>
      <span class="text-[10px] font-mono tracking-widest mt-2">
        <span class="lang-ja">{ui.ja.footer.scrollTop}</span>
        <span class="lang-en">{ui.en.footer.scrollTop}</span>
      </span>
    </a>

    <nav class="flex flex-wrap items-center justify-center gap-x-6 gap-y-3 mt-10">
      {navigationItems.map((item: NavItem) => (
        <a
          href={item.href}
          class="text-sm text-gray-400 hover:text-white transition-colors"
        >
          <span class="lang-ja">{ui.ja.nav[item.key]}</span>
          <span class="lang-en">{ui.en.nav[item.key]}</span>
        </a>
      ))}
    </nav>

    <SnsLinks class="mt-8" />

    <p class="text-xs font-mono text-gray-500 mt-10">
      &copy; {currentYear} otatsu. All rights reserved.
    </p>

  </div>
</footer>

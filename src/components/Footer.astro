---
import { navigationItems, type NavItem } from '../data/navigation';
import { snsLinks, type SnsLink } from '../data/sns';
import { ui } from '../data/ui';
import SnsIcon from './common/SnsIcon.astro';

const currentYear = new Date().getFullYear();
---

<footer class="bg-overlay-bg text-overlay-text">
  <div class="mx-auto flex max-w-5xl flex-col items-center px-4 pt-12 pb-8 md:pt-16">
    <a
      href="#top"
      id="footer-scroll-top"
      class="group flex flex-col items-center text-white/80 transition-colors duration-300 hover:text-accent-teal"
    >
      <svg
        class="h-5 w-5 transition-transform duration-300 group-hover:-translate-y-1"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 15l7-7 7 7"
        ></path>
      </svg>

      <span class="mt-2 text-xs font-semibold tracking-[0.18em]">
        <span class="lang-ja">{ui.ja.footer.scrollTop}</span>
        <span class="lang-en">{ui.en.footer.scrollTop}</span>
      </span>
    </a>

    <nav aria-labelledby="footer-nav-label" class="mt-12 w-full">
      <span id="footer-nav-label" class="sr-only">
        <span class="lang-ja">{ui.ja.a11y.footerNav}</span>
        <span class="lang-en">{ui.en.a11y.footerNav}</span>
      </span>
      <ul class="flex flex-wrap items-center justify-center gap-x-7 gap-y-4 md:gap-x-10">
        {
          navigationItems.map((item: NavItem) => (
            <li>
              <a
                href={item.href}
                class="text-sm font-semibold tracking-[0.14em] text-white/80 transition-colors duration-300 hover:text-accent-teal"
              >
                <span class="lang-ja">{ui.ja.nav[item.key]}</span>
                <span class="lang-en">{ui.en.nav[item.key]}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="mt-8 flex items-center justify-center gap-3">
      {
        snsLinks.map((sns: SnsLink) => (
          <a
            href={sns.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={sns.name}
            title={sns.name}
            class="group flex h-10 w-10 items-center justify-center border border-white/80 text-white/80 transition-all duration-300 hover:border-accent-teal hover:bg-accent-teal hover:text-white"
          >
            <SnsIcon
              name={sns.icon}
              class="h-5 w-5 transition-transform duration-300 group-hover:scale-110"
            />
          </a>
        ))
      }
    </div>

    <p class="mt-8 text-[10px] tracking-[0.12em] text-white/50">
      &copy; {currentYear}
      <span class="lang-ja">{ui.ja.footer.copyRights}</span>
      <span class="lang-en">{ui.en.footer.copyRights}</span>
    </p>
  </div>
</footer>

---
import { getCollection, type CollectionEntry } from 'astro:content';
import PostCard from './common/PostCard.astro';
import { ui } from '../data/ui';

const toDateNumber = (date?: string) => {
  if (!date) return 0;
  const match = date.trim().match(/^(\d{4})[/-](\d{1,2})[/-](\d{1,2})$/);
  if (!match) return 0;
  return Number(match[1]) * 10000 + Number(match[2]) * 100 + Number(match[3]);
};

const posts: CollectionEntry<'posts'>[] = await getCollection('posts');

const latestPosts = posts
  .filter((post) => post.data.published)
  .sort((a, b) => toDateNumber(b.data.date) - toDateNumber(a.data.date))
  .slice(0, 3);
---

<section id="latest" class="pt-20 pb-0">
  <div class="mb-10">
    <h2 class="text-4xl font-bold tracking-tight text-[var(--color-text)] md:text-5xl lg:text-6xl">
      <span class="lang-ja">{ui.ja.sections.postsTitle}</span>
      <span class="lang-en">{ui.en.sections.postsTitle}</span>
    </h2>
  </div>

  {latestPosts.length > 0 ? (
    <>
      <div>
        {latestPosts.map((post) => (
          <PostCard entry={post} />
        ))}
      </div>

      <div class="mt-5 flex justify-center">
        <a
          href="/posts/"
          class="inline-block text-4xl font-bold tracking-[0.16em] text-[var(--color-accent-green)] transition-all duration-300 hover:-translate-y-1 hover:text-[var(--color-accent-teal)] md:text-5xl"
        >
          MORE
        </a>
      </div>
    </>
  ) : (
    <div class="border-t border-[var(--color-border)] py-5 text-sm text-[var(--color-muted)]">
      <span class="lang-ja">{ui.ja.messages.noPosts}</span>
      <span class="lang-en">{ui.en.messages.noPosts}</span>
    </div>
  )}
</section>

---
import PostCard from './common/PostCard.astro';
import SectionHeading from './common/SectionHeading.astro';
import MoreLink from './common/MoreLink.astro';
import { ui } from '../data/ui';
import { routes } from '../data/routes';
import { getPublishedEntries } from '../utils/content';

const latestPosts = (await getPublishedEntries('posts')).slice(0, 3);
---

<section id="latest" class="pt-10">
  <SectionHeading ja={ui.ja.sections.postsTitle} en={ui.en.sections.postsTitle} />

  {
    latestPosts.length > 0 ? (
      <>
        <div>
          {latestPosts.map((post) => (
            <PostCard entry={post} />
          ))}
        </div>

        <div class="mt-5 flex justify-center">
          <MoreLink href={routes.posts} />
        </div>
      </>
    ) : (
      <div class="border-t border-border py-5 text-sm text-muted">
        <span class="lang-ja">{ui.ja.messages.noPosts}</span>
        <span class="lang-en">{ui.en.messages.noPosts}</span>
      </div>
    )
  }
</section>

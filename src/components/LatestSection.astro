---
import { getCollection, type CollectionEntry } from 'astro:content';
import PostCard from './common/PostCard.astro';
import SectionHeading from './common/SectionHeading.astro';
import MoreLink from './common/MoreLink.astro';
import { ui } from '../data/ui';
import { toDateNumber } from '../utils/date';

const posts: CollectionEntry<'posts'>[] = await getCollection('posts');
const latestPosts = posts
  .filter((post) => post.data.published)
  .sort((a, b) => toDateNumber(b.data.date) - toDateNumber(a.data.date))
  .slice(0, 3);
---

<section id="latest" class="pb-0 pt-20">
  <SectionHeading ja={ui.ja.sections.postsTitle} en={ui.en.sections.postsTitle} />

  {
    latestPosts.length > 0 ? (
      <>
        <div>
          {latestPosts.map((post) => (
            <PostCard entry={post} />
          ))}
        </div>

        <div class="mt-5 flex justify-center">
          <MoreLink href="/posts/" />
        </div>
      </>
    ) : (
      <div class="border-t border-[var(--color-border)] py-5 text-sm text-[var(--color-muted)]">
        <span class="lang-ja">{ui.ja.messages.noPosts}</span>
        <span class="lang-en">{ui.en.messages.noPosts}</span>
      </div>
    )
  }

  <div class="mt-10 flex justify-center pb-10">
    <div
      class="h-10 w-[50vw] max-w-[1200px] bg-[var(--color-accent-green)] transition-colors duration-300 hover:bg-[var(--color-accent-orange)]"
    ></div>
  </div>

</section>

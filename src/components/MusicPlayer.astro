---
import { siteText } from '../data/site';

interface Props {
  /** BGMの初期音量 (0.0 ~ 1.0)。変更しやすいようここで一元管理する */
  volume?: number;
}

const { volume = 0.3 } = Astro.props;
---

<!--
  【この方式にした理由】
  以前はCSSアニメーション(animation-play-state)の付け外しで波を表現していたが、
  スマホで「一時停止→再生」すると波が復活しないという報告が、
  ブラウザの種類を問わず繰り返し発生していた。
  CSSアニメーションの再開自体に何かしら不確実性がある（原因を断定できていない）と
  判断し、CSSアニメーションへの依存を完全にやめた。

  今の実装は非常に単純：
  setInterval を1つだけ、ページ読み込み時から常に動かし続け、
  毎回 bgm.paused を直接読んで、再生中なら各バーの高さを直接書き換え、
  停止中ならすべて2pxに戻す。それだけ。
  ・CSSアニメーションの開始/一時停止/再開という概念を一切使わない
  （＝ブラウザ側の「再開時に反映されない」系の不具合が原理的に起こり得ない）
  ・setIntervalはrequestAnimationFrameと違い、コールバック内で例外が起きても
  次のtickの実行が止まらない（rAFの自己再帰と違い、ブラウザが独立してスケジュールする）
  ・AudioContext/AnalyserNodeは使わない（再生そのものを阻害するリスクを排除）
-->
<div class="fixed bottom-5 left-5 z-50">
  <button
    id="music-toggle"
    type="button"
    data-label={siteText.music.label}
    class="w-24 h-8 border border-black bg-white text-black flex flex-col items-center justify-center font-mono font-bold text-xs shadow-sm hover:bg-black hover:text-white transition-colors"
    aria-label="音楽を再生"
  >
    <span id="music-label" class="text-xs leading-none">▶ {siteText.music.label}</span>
    <span id="music-wave" class="flex items-end justify-center gap-[2px] h-2 w-16 mt-[3px]" aria-hidden="true">
      {Array.from({ length: 16 }).map(() => (
        <span class="wave-bar"></span>
      ))}
    </span>
  </button>
</div>

<audio id="bgm" src="/audio/background.mp3" loop preload="auto" data-volume={String(volume)}></audio>

<style>
  .wave-bar {
    width: 2px;
    height: 2px;
    background-color: black;
  }

  #music-toggle:hover .wave-bar {
    background-color: white;
  }
</style>

<script>
  const bgm = document.getElementById('bgm') as HTMLAudioElement | null;
  const musicToggle = document.getElementById('music-toggle');
  const musicLabel = document.getElementById('music-label');
  const waveBars = Array.from(document.querySelectorAll('#music-wave .wave-bar')) as HTMLElement[];

  if (bgm) {
    // 音量は MusicPlayer.astro の volume プロパティ（既定 0.3）から受け取る
    bgm.volume = Number(bgm.dataset.volume ?? '0.3');
  }

  function updateLabel() {
    if (!bgm || !musicLabel || !musicToggle) return;
    const label = (musicToggle as HTMLElement).dataset.label ?? 'MUSIC';
    musicLabel.textContent = bgm.paused ? `▶ ${label}` : `■ ${label}`;
  }

  // 波の描画本体。100msごとに呼ばれる。
  // bgm.paused を直接読むだけなので、誰がどの経路で再生/停止したかを一切気にしない。
  function tick() {
    if (bgm && !bgm.paused) {
      const now = Date.now() / 200;
      waveBars.forEach((bar, index) => {
        const wave = Math.sin(now + index * 0.6) * 0.5 + 0.5;
        bar.style.height = `${2 + wave * 6}px`;
      });
    } else {
      waveBars.forEach((bar) => {
        bar.style.height = '2px';
      });
    }
  }

  // setIntervalは、中のコールバックで例外が起きても次回の呼び出しが止まらない
  // （requestAnimationFrameの自己再帰と違い、ブラウザ側が独立してスケジュールするため）。
  // これにより「一度エラーが起きるとループごと死んで波が二度と出てこない」
  // という不具合クラスが構造的に起こり得なくなる。
  setInterval(() => {
    try {
      tick();
    } catch {
      // 何が起きても次のtickには影響しない
    }
  }, 100);

  updateLabel();

  bgm?.addEventListener('play', updateLabel);
  bgm?.addEventListener('pause', updateLabel);

  async function togglePlayback() {
    if (!bgm) return;

    try {
      if (bgm.paused) {
        await bgm.play();
      } else {
        bgm.pause();
      }
    } catch {
      // 自動再生ポリシーなどで失敗した場合は何もしない
    }

    updateLabel();
  }

  musicToggle?.addEventListener('click', togglePlayback);

  window.addEventListener('load', async () => {
    if (!bgm) return;

    try {
      await bgm.play();
    } catch {
      // 自動再生がブロックされた場合は手動再生を待つ
    }

    updateLabel();
  });

  window.addEventListener('stop-bgm', () => {
    if (bgm && !bgm.paused) {
      bgm.pause();
      updateLabel();
    }
  });

  // キーボード操作: m で再生 / 停止（ミュート）を切り替える
  window.addEventListener('keydown', (event) => {
    if (event.key !== 'm') return;

    // 入力中や修飾キー併用時はショートカットを無効にする
    const target = event.target as HTMLElement | null;
    if (target && /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName)) return;
    if (event.metaKey || event.ctrlKey || event.altKey) return;

    event.preventDefault();
    togglePlayback();
  });
</script>

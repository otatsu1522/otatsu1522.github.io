---
import { siteText } from '../data/site';

interface Props {
  /** BGMの初期音量 (0.0 ~ 1.0)。変更しやすいようここで一元管理する */
  volume?: number;
}

const { volume = 0.3 } = Astro.props;
---

<!--
  【設計を全面的にやり直した経緯】
  以前は AnalyserNode (Web Audio API) で実際の音声波形を取得して描画していたが、
  スマホでボタンをタップして一時停止→再生すると波形が復活しない不具合が
  何度修正しても再発していた。原因の切り分けが難しい理由は、
  createMediaElementSource() で <audio> をWeb Audio Graphに接続すると、
  それ以降そのタグの音声出力は AudioContext 経由でしか鳴らなくなり、
  スマホでは AudioContext の生成/resumeがユーザー操作のタイミングに
  非常にシビアで、状況によってはサウンド出力そのものが
  無音のまま固まってしまうことがあるため（＝波形うんぬん以前の問題）。

  そのため今回は「実音声を解析して波形を描く」方式を完全に廃止し、
  AudioContext/AnalyserNodeを一切使わない構成にした。
  波形は bgm.paused の状態だけを見てCSSアニメーションの
  再生/一時停止(animation-play-state)を切り替えているだけなので、
  例外が起きる余地そのものがなく、原理的に「波が復活しない」状態になり得ない。
-->
<div class="fixed bottom-5 left-5 z-50">
  <button
    id="music-toggle"
    type="button"
    data-label={siteText.music.label}
    class="w-24 h-8 border border-black bg-white text-black flex flex-col items-center justify-center font-mono font-bold text-xs shadow-sm hover:bg-black hover:text-white transition-colors"
    aria-label="音楽を再生"
  >
    <span id="music-label" class="text-xs leading-none">▶ {siteText.music.label}</span>
    <span id="music-wave" class="flex items-end justify-center gap-[2px] h-2 w-16 mt-[3px]" aria-hidden="true">
      {Array.from({ length: 16 }).map((_, i) => (
        <span class="wave-bar" style={`animation-delay:${(i % 8) * 90}ms`}></span>
      ))}
    </span>
  </button>
</div>

<audio id="bgm" src="/audio/background.mp3" loop preload="auto" data-volume={String(volume)}></audio>

<style>
  .wave-bar {
    width: 2px;
    height: 2px;
    background-color: black;
    transform-origin: bottom;
    animation: wave-bounce 0.8s ease-in-out infinite;
    animation-play-state: paused;
  }

  #music-toggle:hover .wave-bar {
    background-color: white;
  }

  /* 再生中のみアニメーションを走らせる。JSはこのクラスの付け外しだけを行う。 */
  #music-wave.is-playing .wave-bar {
    animation-play-state: running;
  }

  @keyframes wave-bounce {
    0%,
    100% {
      height: 2px;
    }
    50% {
      height: 8px;
    }
  }
</style>

<script>
  const bgm = document.getElementById('bgm') as HTMLAudioElement | null;
  const musicToggle = document.getElementById('music-toggle');
  const musicLabel = document.getElementById('music-label');
  const musicWave = document.getElementById('music-wave');

  if (bgm) {
    // 音量は MusicPlayer.astro の volume プロパティ（既定 0.3）から受け取る
    bgm.volume = Number(bgm.dataset.volume ?? '0.3');
  }

  // 表示（ラベルの文字・波アニメーションのON/OFF）を bgm.paused の値だけを見て更新する。
  // 再生/一時停止の実際の処理（play()/pause()の呼び出し）とは完全に分離しており、
  // 'play'/'pause' イベントさえ発火すれば必ず正しい見た目になる。
  function syncUI() {
    if (!bgm || !musicLabel || !musicToggle || !musicWave) return;

    const label = (musicToggle as HTMLElement).dataset.label ?? 'MUSIC';
    musicLabel.textContent = bgm.paused ? `▶ ${label}` : `■ ${label}`;
    musicWave.classList.toggle('is-playing', !bgm.paused);
  }

  // 'play'/'pause' はユーザーの操作経路（ボタン、mキー、他タブでの停止指示など）に
  // 関わらず、実際に再生状態が変わったタイミングで必ず発火するブラウザ標準のイベント。
  // UIの更新はこのイベントだけをトリガーにすることで、
  // 「どのボタン操作から呼ばれたか」を気にしなくてよいシンプルな構成にしている。
  bgm?.addEventListener('play', syncUI);
  bgm?.addEventListener('pause', syncUI);

  async function togglePlayback() {
    if (!bgm) return;

    try {
      if (bgm.paused) {
        await bgm.play();
      } else {
        bgm.pause();
      }
    } catch {
      // 自動再生ポリシーなどで失敗しても何もしない（UIは現在のpaused状態に追従する）
      syncUI();
    }
  }

  musicToggle?.addEventListener('click', togglePlayback);

  window.addEventListener('load', async () => {
    if (!bgm) return;

    try {
      await bgm.play();
    } catch {
      // 自動再生がブロックされた場合は手動再生を待つ（'pause'イベントでUIは正しい状態になる）
    }

    syncUI();
  });

  window.addEventListener('stop-bgm', () => {
    if (bgm && !bgm.paused) {
      bgm.pause();
    }
  });

  // キーボード操作: m で再生 / 停止（ミュート）を切り替える
  window.addEventListener('keydown', (event) => {
    if (event.key !== 'm') return;

    // 入力中や修飾キー併用時はショートカットを無効にする
    const target = event.target as HTMLElement | null;
    if (target && /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName)) return;
    if (event.metaKey || event.ctrlKey || event.altKey) return;

    event.preventDefault();
    togglePlayback();
  });
</script>

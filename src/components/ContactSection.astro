---
import { siteConfig } from '../data/site';
import { ui } from '../data/ui';
---

<section id="contact" class="pt-20 pb-0">
  <div class="flex items-baseline gap-2 mb-6">
    <h2 class="text-2xl font-bold text-[var(--color-text)]">
      <span class="lang-ja">{ui.ja.sections.contactTitle}</span>
      <span class="lang-en">{ui.en.sections.contactTitle}</span>
    </h2>

    <span class="lang-ja text-xs text-[var(--color-muted)]">
      {ui.ja.sections.contactSubtitle}
    </span>

    <span class="lang-en text-xs text-[var(--color-muted)]">
      {ui.en.sections.contactSubtitle}
    </span>
  </div>

  <div class="bg-[var(--color-bg)] border border-[var(--color-border)] p-6 md:p-8 text-center">
    <p class="text-sm sm:text-base text-[var(--color-muted)] mb-6">
      <span class="lang-ja">{siteConfig.ja.contactDescription}</span>
      <span class="lang-en">{siteConfig.en.contactDescription}</span>
    </p>

    <a
      href={`mailto:${siteConfig.ja.email}`}
      class="text-base sm:text-lg text-[var(--color-text)] hover:opacity-60 transition-colors break-all"
    >
      {siteConfig.ja.email}
    </a>
  </div>
</section>

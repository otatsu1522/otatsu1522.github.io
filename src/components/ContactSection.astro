---
import { siteConfig } from '../data/site';
import { ui } from '../data/ui';

const [emailUser, emailDomain] = siteConfig.ja.email.split('@');
---

<section id="contact" class="pt-20 pb-0">
  <div class="mb-10 text-center">
    <h2 class="text-4xl font-bold tracking-tight text-[var(--color-text)] md:text-5xl lg:text-6xl">
      <span class="lang-ja">{ui.ja.sections.contactTitle}</span>
      <span class="lang-en">{ui.en.sections.contactTitle}</span>
    </h2>
  </div>

  <div class="py-5 text-center md:py-5">
    <p class="mx-auto max-w-xl text-sm leading-relaxed text-[var(--color-muted)] md:text-base">
      <span class="lang-ja">{siteConfig.ja.contactDescription}</span>
      <span class="lang-en">{siteConfig.en.contactDescription}</span>
    </p>

    <a
      id="contact-mail"
      href="#"
      class="mt-8 inline-block text-4xl font-bold tracking-[0.16em] text-[var(--color-accent-green)] transition-all duration-300 hover:text-[var(--color-accent-teal)] hover:-translate-y-1 md:text-5xl"
    >
      <span class="lang-ja">{siteConfig.ja.contactAction}</span>
      <span class="lang-en">{siteConfig.en.contactAction}</span>
    </a>
  </div>
</section>

<script define:vars={{ emailUser, emailDomain }}>
  const initContactMail = () => {
    const link = document.getElementById('contact-mail');

    if (!link) return;
    if (link.dataset.initialized === 'true') return;

    link.addEventListener('click', (event) => {
      event.preventDefault();
      window.location.href = `mailto:${emailUser}@${emailDomain}`;
    });

    link.dataset.initialized = 'true';
  };

  document.addEventListener('DOMContentLoaded', initContactMail);
  document.addEventListener('astro:page-load', initContactMail);
  document.addEventListener('astro:after-swap', initContactMail);
</script>

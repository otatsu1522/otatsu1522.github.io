---
import { siteConfig } from '../data/site';
import { ui } from '../data/ui';
---

<section id="contact" class="pt-20 pb-0">
  <div class="mb-10 text-center">
    <h2 class="text-4xl font-bold tracking-tight text-[var(--color-text)] md:text-5xl lg:text-6xl">
      <span class="lang-ja">{ui.ja.sections.contactTitle}</span>
      <span class="lang-en">{ui.en.sections.contactTitle}</span>
    </h2>
  </div>

  <div class="border-t border-[var(--color-border)] py-10 text-center md:py-14">
    <p class="mx-auto max-w-2xl text-sm leading-relaxed text-[var(--color-muted)] md:text-base">
      <span class="lang-ja">{siteConfig.ja.contactDescription}</span>
      <span class="lang-en">{siteConfig.en.contactDescription}</span>
    </p>

    <a
      href={`mailto:${siteConfig.ja.email}`}
      class="mt-8 inline-block break-all text-2xl font-semibold tracking-tight text-[var(--color-text)] transition-colors duration-300 hover:text-[var(--color-accent-teal)] sm:text-3xl md:text-4xl lg:text-5xl"
    >
      {siteConfig.ja.email}
    </a>
  </div>
</section>

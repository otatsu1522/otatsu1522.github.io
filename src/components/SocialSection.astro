---
import { snsLinks, type SnsLink } from '../data/sns';
import { ui } from '../data/ui';
import SnsIcon from './common/SnsIcon.astro';
---

<section id="social" class="pt-20 pb-0">
  <div class="flex items-baseline gap-2 mb-6">
    <h2 class="text-2xl font-bold text-[var(--color-text)]">
      <span class="lang-ja">{ui.ja.sections.socialTitle}</span>
      <span class="lang-en">{ui.en.sections.socialTitle}</span>
    </h2>
    <span class="lang-ja text-xs text-[var(--color-muted)]">{ui.ja.sections.socialSubtitle}</span>
    <span class="lang-en text-xs text-[var(--color-muted)]">{ui.en.sections.socialSubtitle}</span>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
    {snsLinks.map((sns: SnsLink) => (
      <a
        href={sns.url}
        target="_blank"
        rel="noopener noreferrer"
        class="block p-5 bg-[var(--color-bg)] border border-[var(--color-border)] text-[var(--color-muted)] hover:text-[var(--color-text)] hover:border-[var(--color-text)] hover:bg-[var(--color-border)] transition-all"
      >
        <div class="flex items-center gap-3">
          <SnsIcon name={sns.icon} class="w-7 h-7 shrink-0" />
          <div class="text-sm font-medium">
            {sns.name}
          </div>
        </div>

        <p class="lang-ja text-xs text-[var(--color-muted)] mt-3 leading-relaxed">
          {sns.description.ja}
        </p>

        <p class="lang-en text-xs text-[var(--color-muted)] mt-3 leading-relaxed">
          {sns.description.en}
        </p>
      </a>
    ))}
  </div>
</section>

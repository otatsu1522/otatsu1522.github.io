---
import { snsLinks, type SnsLink } from '../data/sns';
import { ui } from '../data/ui';
---

<section id="social" class="pt-20 pb-0">
  <div class="flex items-baseline gap-2 mb-6">
    <h2 class="text-2xl font-bold text-white">
      <span class="lang-ja">{ui.ja.sections.socialTitle}</span>
      <span class="lang-en">{ui.en.sections.socialTitle}</span>
    </h2>
    <span class="lang-ja text-xs text-gray-400">{ui.ja.sections.socialSubtitle}</span>
  </div>
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
    {snsLinks.map((sns: SnsLink) => (
      <a
        href={sns.url}
        target="_blank"
        rel="noopener noreferrer"
        class="block p-3 text-center bg-slate-800/50 border border-slate-800 text-sm text-gray-300 hover:text-white hover:border-slate-600 transition-colors"
      >
        {sns.name}
      </a>
    ))}
  </div>
</section>

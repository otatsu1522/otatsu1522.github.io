---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ui } from '../data/ui';

const galleryImages = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>(
    '../assets/images/gallery/*.{jpg,jpeg,png,webp,avif}',
    { eager: true }
  )
)
  .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
  .map(([, module]) => module.default);

const MOBILE_HEIGHT = 240;
const DESKTOP_HEIGHT = 360;

const VIEW_ALL_CLASS =
  'inline-flex items-center gap-2 px-5 py-2.5 border border-white/10 bg-white/5 text-sm text-gray-300 hover:text-white hover:border-white/20 hover:bg-white/10 transition-all';
---

<section
  id="gallery"
  class="pt-20 pb-0"
  style={`--gallery-mobile-height:${MOBILE_HEIGHT}px;--gallery-desktop-height:${DESKTOP_HEIGHT}px;`}
>
  <div class="flex items-baseline gap-2 mb-6">
    <h2 class="text-2xl font-bold text-white">
      <span class="lang-ja">{ui.ja.sections.galleryTitle}</span>
      <span class="lang-en">{ui.en.sections.galleryTitle}</span>
    </h2>

    <span class="lang-ja text-xs text-gray-400">{ui.ja.sections.gallerySubtitle}</span>
    <span class="lang-en text-xs text-gray-400">{ui.en.sections.gallerySubtitle}</span>
  </div>

  {galleryImages.length > 0 && (
    <>
      <div class="relative -mx-4 w-[calc(100%+2rem)] md:w-screen md:-ml-[calc(50vw-50%)]">
        <div class="hidden md:block absolute inset-0 z-20 pointer-events-none">
          <div class="max-w-5xl mx-auto px-4 h-full relative">
            <button
              type="button"
              data-gallery-prev
              aria-label="Previous"
              class="pointer-events-auto absolute left-8 top-1/2 -translate-y-1/2 w-[42px] h-[42px] bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 text-white flex items-center justify-center backdrop-blur-md transition-all shadow-lg hover:scale-105 active:scale-95 cursor-pointer"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 19l-7-7 7-7"
                ></path>
              </svg>
            </button>

            <button
              type="button"
              data-gallery-next
              aria-label="Next"
              class="pointer-events-auto absolute right-8 top-1/2 -translate-y-1/2 w-[42px] h-[42px] bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 text-white flex items-center justify-center backdrop-blur-md transition-all shadow-lg hover:scale-105 active:scale-95 cursor-pointer"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"
                ></path>
              </svg>
            </button>
          </div>
        </div>

        <div id="gallery-carousel-viewport" class="gallery-carousel-viewport">
          <div id="gallery-carousel-track" class="gallery-carousel-track">
            {galleryImages.map((image, index) => (
              <div class="gallery-carousel-item">
                <div class="gallery-carousel-card">
                  <Image
                    src={image}
                    alt={`${ui.ja.sections.galleryTitle} ${index + 1}`}
                    class="gallery-carousel-image"
                    loading={index < 3 ? 'eager' : 'lazy'}
                  />
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="hidden md:flex justify-center mt-6">
        <a href="/gallery/" class={VIEW_ALL_CLASS}>
          <span class="lang-ja">{ui.ja.buttons.viewAllGallery}</span>
          <span class="lang-en">{ui.en.buttons.viewAllGallery}</span>
        </a>
      </div>

      <div class="flex md:hidden items-center justify-center gap-2 mt-6">
        <button
          type="button"
          data-gallery-prev
          aria-label="Previous"
          class="w-10 h-10 bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 text-white flex items-center justify-center backdrop-blur-md transition-all shadow-lg hover:scale-105 active:scale-95 cursor-pointer shrink-0"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 19l-7-7 7-7"
            ></path>
          </svg>
        </button>

        <a href="/gallery/" class={VIEW_ALL_CLASS}>
          <span class="lang-ja">{ui.ja.buttons.viewAllGallery}</span>
          <span class="lang-en">{ui.en.buttons.viewAllGallery}</span>
        </a>

        <button
          type="button"
          data-gallery-next
          aria-label="Next"
          class="w-10 h-10 bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 text-white flex items-center justify-center backdrop-blur-md transition-all shadow-lg hover:scale-105 active:scale-95 cursor-pointer shrink-0"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 5l7 7-7 7"
            ></path>
          </svg>
        </button>
      </div>
    </>
  )}
</section>

<style>
  .gallery-carousel-viewport {
    position: relative;
    width: 100%;
    height: var(--gallery-mobile-height);
    overflow: hidden;
    touch-action: pan-y;
  }

  .gallery-carousel-track {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .gallery-carousel-item {
    position: absolute;
    left: 50%;
    top: 50%;
    height: var(--gallery-mobile-height);
    will-change: transform, opacity;
    transition:
      transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.4s ease;
    cursor: pointer;
  }

  .gallery-carousel-card {
    height: 100%;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
  }

  .gallery-carousel-image {
    display: block;
    width: auto;
    height: 100%;
    max-width: none;
  }

  @media (min-width: 768px) {
    .gallery-carousel-viewport {
      height: var(--gallery-desktop-height);
    }

    .gallery-carousel-item {
      height: var(--gallery-desktop-height);
    }
  }
</style>

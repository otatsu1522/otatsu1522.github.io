---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ui } from '../data/ui';

const galleryImages = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>(
    '../assets/images/gallery/*.{jpg,jpeg,png,webp,avif}',
    {
      eager: true,
    }
  )
)
  .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
  .map(([, module]) => module.default);

const MOBILE_HEIGHT = 240; // スマホ時の写真の高さ(px)
const DESKTOP_HEIGHT = 360; // PC時の写真の高さ(px)
---

<section
  id="gallery"
  class="pt-20 pb-0"
  style={`--gallery-mobile-height:${MOBILE_HEIGHT}px;--gallery-desktop-height:${DESKTOP_HEIGHT}px;`}
>
  <div class="flex items-baseline gap-2 mb-6">
    <h2 class="text-2xl font-bold text-white">
      <span class="lang-ja">{ui.ja.sections.galleryTitle}</span>
      <span class="lang-en">{ui.en.sections.galleryTitle}</span>
    </h2>

    <span class="lang-ja text-xs text-gray-400">
      {ui.ja.sections.gallerySubtitle}
    </span>

    <span class="lang-en text-xs text-gray-400">
      {ui.en.sections.gallerySubtitle}
    </span>
  </div>

  {galleryImages.length > 0 && (
    <div id="gallery-viewport" class="gallery-viewport">
      <div id="gallery-track" class="gallery-track">
        <div id="gallery-set" class="gallery-set">
          {galleryImages.map((image, index) => (
            <div class="gallery-item">
              <Image
                src={image}
                alt={`${ui.ja.sections.galleryTitle} ${index + 1}`}
                class="gallery-image"
                loading="eager"
              />
            </div>
          ))}
        </div>

        <div class="gallery-set" aria-hidden="true">
          {galleryImages.map((image) => (
            <div class="gallery-item">
              <Image
                src={image}
                alt=""
                class="gallery-image"
                loading="lazy"
              />
            </div>
          ))}
        </div>
      </div>
    </div>
  )}
</section>

<style>
  .gallery-viewport {
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    overflow: hidden;
  }

  .gallery-track {
    display: flex;
    width: max-content;
    margin: 0;
    padding: 0;
    will-change: transform;
  }

  .gallery-set {
    display: flex;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
  }

  .gallery-item {
    display: block;
    flex: 0 0 auto;
    height: var(--gallery-mobile-height);
    margin: 0;
    padding: 0;
    overflow: hidden;
  }

  .gallery-image {
    display: block;
    width: auto;
    height: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 768px) {
    .gallery-item {
      height: var(--gallery-desktop-height);
    }
  }
</style>

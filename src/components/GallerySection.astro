---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ui } from '../data/ui';
import GalleryLightbox from './common/GalleryLightbox.astro';

const galleryImages = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>(
    '../assets/images/gallery/*.{jpg,jpeg,png,webp,avif}',
    { eager: true }
  )
)
  .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
  .map(([, module]) => module.default);

const fullImageSrcs = await Promise.all(
  galleryImages.map(async (image) => (await getImage({ src: image, width: image.width })).src)
);

const DESKTOP_HEIGHT = 400;
const MOBILE_HEIGHT = 200;

const NAV_BUTTON_CLASS =
  'bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 text-white flex items-center justify-center backdrop-blur-md transition-all shadow-lg hover:scale-105 active:scale-95 cursor-pointer shrink-0';

const VIEW_ALL_CLASS =
  'inline-flex items-center gap-2 px-5 py-2.5 border border-white/10 bg-white/5 text-sm text-gray-300 hover:text-white hover:border-white/20 hover:bg-white/10 transition-all';
---

<section
  id="gallery"
  class="pt-20 pb-0"
  style={`--gallery-desktop-height:${DESKTOP_HEIGHT}px;--gallery-mobile-height:${MOBILE_HEIGHT}px;`}
>
  <div class="flex items-baseline gap-2 mb-6">
    <h2 class="text-2xl font-bold text-white">
      <span class="lang-ja">{ui.ja.sections.galleryTitle}</span>
      <span class="lang-en">{ui.en.sections.galleryTitle}</span>
    </h2>

    <span class="lang-ja text-xs text-gray-400">{ui.ja.sections.gallerySubtitle}</span>
    <span class="lang-en text-xs text-gray-400">{ui.en.sections.gallerySubtitle}</span>
  </div>

  {galleryImages.length > 0 && (
    <>
      {/* ==================== PC専用 ==================== */}
      <div class="hidden md:block relative w-screen -ml-[calc(50vw-50%)]">
        <div class="absolute inset-0 z-[200] pointer-events-none">
          <div class="max-w-[61rem] mx-auto h-full relative">
            <button
              type="button"
              data-gallery-desktop-prev
              aria-label="Previous"
              class={`pointer-events-auto absolute left-[-3.5rem] top-[calc(50%_-_40px)] w-[42px] h-[42px] ${NAV_BUTTON_CLASS}`}
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
              </svg>
            </button>

            <button
              type="button"
              data-gallery-desktop-next
              aria-label="Next"
              class={`pointer-events-auto absolute right-[-3.5rem] top-[calc(50%_-_40px)] w-[42px] h-[42px] ${NAV_BUTTON_CLASS}`}
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </button>
          </div>
        </div>

        <div
          id="gallery-desktop-viewport"
          class="gallery-desktop-viewport"
          style="visibility:hidden;"
        >
          <div id="gallery-desktop-track" class="gallery-desktop-track">
            {galleryImages.map((image, index) => (
              <button
                type="button"
                class="gallery-desktop-item"
                data-gallery-open
                data-full-src={fullImageSrcs[index]}
              >
                <Image
                  src={image}
                  alt={`${ui.ja.sections.galleryTitle} ${index + 1}`}
                  class="gallery-desktop-image"
                  loading="eager"
                />
              </button>
            ))}
          </div>
        </div>
      </div>

      <div class="hidden md:flex justify-center mt-6">
        <a href="/gallery/" class={VIEW_ALL_CLASS}>
          <span class="lang-ja">{ui.ja.buttons.viewAllGallery}</span>
          <span class="lang-en">{ui.en.buttons.viewAllGallery}</span>
        </a>
      </div>

      {/* ==================== スマホ専用 ==================== */}
      <div class="md:hidden -mx-4 w-[calc(100%+2rem)] overflow-hidden">
        <div id="gallery-mobile-container" class="gallery-mobile-container">
          {galleryImages.map((image, index) => (
            <button
              type="button"
              class="gallery-mobile-item"
              data-gallery-open
              data-full-src={fullImageSrcs[index]}
            >
              <Image
                src={image}
                alt={`${ui.ja.sections.galleryTitle} ${index + 1}`}
                class="gallery-mobile-image"
                loading={index < 3 ? 'eager' : 'lazy'}
              />
            </button>
          ))}
        </div>
      </div>

      <div class="flex md:hidden items-center justify-center gap-2 mt-6 px-4">
        <button
          type="button"
          data-gallery-mobile-prev
          aria-label="Previous"
          class={`w-10 h-10 ${NAV_BUTTON_CLASS}`}
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
        </button>

        <a href="/gallery/" class={VIEW_ALL_CLASS}>
          <span class="lang-ja">{ui.ja.buttons.viewAllGallery}</span>
          <span class="lang-en">{ui.en.buttons.viewAllGallery}</span>
        </a>

        <button
          type="button"
          data-gallery-mobile-next
          aria-label="Next"
          class={`w-10 h-10 ${NAV_BUTTON_CLASS}`}
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </button>
      </div>
    </>
  )}

  <GalleryLightbox />
</section>

<style>
.gallery-desktop-viewport {
  position: relative;
  width: 100%;
  height: var(--gallery-desktop-height);
  overflow: hidden;
  touch-action: pan-y;
}

.gallery-desktop-track {
  position: relative;
  width: 100%;
  height: 100%;
}

.gallery-desktop-item {
  position: absolute;
  left: 50%;
  top: 50%;
  height: var(--gallery-desktop-height);
  padding: 0;
  border: none;
  background: none;
  will-change: transform, opacity;
  transition:
    transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
    opacity 0.4s ease;
  cursor: pointer;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
}

.gallery-desktop-image {
  display: block;
  width: auto;
  height: 100%;
  max-width: none;
}

.gallery-mobile-container {
  display: flex;
  gap: 0.5rem;
  padding: 0 1rem;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
  -ms-overflow-style: none;
}

.gallery-mobile-container::-webkit-scrollbar {
  display: none;
}

.gallery-mobile-item {
  flex: 0 0 auto;
  height: var(--gallery-mobile-height);
  padding: 0;
  border: none;
  background: none;
  scroll-snap-align: center;
  cursor: pointer;
}

.gallery-mobile-image {
  display: block;
  width: auto;
  height: 100%;
  max-width: none;
}
</style>

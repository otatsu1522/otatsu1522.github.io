---
import { Image } from 'astro:assets';
import { siteConfig } from '../data/site';
import heroImg from '../assets/images/common/hero.jpg';
---

<section class="relative w-full h-[100svh] md:h-[100dvh] overflow-hidden mb-12">
  <div class="relative w-full h-full">
    <!-- 画像を全画面表示・中央カバー -->
    <Image
      src={heroImg}
      alt={siteConfig.ja.author}
      class="hero-image w-full h-full object-cover block"
      priority
    />

    <!-- オーバーレイ -->
    <div class="absolute inset-0 bg-gradient-to-b from-black/60 from-0% via-black/30 via-70% to-black to-100% pointer-events-none"></div>

    <!-- 画像表示用マスク -->
    <div id="hero-image-mask" class="absolute inset-0 bg-black z-10"></div>

    <!-- 中央メッセージ -->
    <div class="absolute inset-0 flex flex-col items-center justify-center text-center px-4 z-20">
      <div class="text-white tracking-wider drop-shadow-md flex flex-col items-center">
        <p
          id="hero-greeting"
          class="text-xl sm:text-3xl md:text-4xl font-medium mb-2 min-h-[1.2em] whitespace-nowrap"
        ></p>
        <p
          id="hero-name"
          class="text-6xl sm:text-8xl md:text-9xl font-extrabold my-2 min-h-[1.2em] whitespace-nowrap"
        ></p>
        <p
          id="hero-tagline"
          class="text-xl sm:text-3xl md:text-4xl font-medium mt-2 min-h-[1.2em] whitespace-nowrap -translate-y-2"
        ></p>
      </div>
    </div>
  </div>
</section>

<style>
  #hero-image-mask {
    will-change: transform;
  }

  .hero-image-reveal {
    animation: hero-image-reveal 1.5s linear forwards;
  }

  @keyframes hero-image-reveal {
    from {
      transform: translateY(0);
    }

    to {
      transform: translateY(100%);
    }
  }
</style>

<script>
  const greeting = document.getElementById('hero-greeting');
  const name = document.getElementById('hero-name');
  const tagline = document.getElementById('hero-tagline');
  const heroImageMask = document.getElementById('hero-image-mask');

  if (greeting && name && tagline && heroImageMask) {
    const typeText = async (element: HTMLElement, text: string, speed: number) => {
      for (const character of text) {
        element.textContent += character;
        await new Promise((resolve) => setTimeout(resolve, speed));
      }
    };

    const startTyping = async () => {
      await typeText(greeting, 'HELLO WORLD', 50);
      await new Promise((resolve) => setTimeout(resolve, 100));
      await typeText(name, 'OTATSU', 100);
      await new Promise((resolve) => setTimeout(resolve, 100));
      await typeText(tagline, 'JOURNEY IS MY LIFE', 50);
      heroImageMask.classList.add('hero-image-reveal');
    };

    startTyping();
  }
</script>

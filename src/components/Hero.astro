---
import { Image } from 'astro:assets';
import { siteConfig } from '../data/site';
import heroImg from '../assets/images/common/hero.jpg';

const hero = siteConfig.en.hero;
---

<section
  id="top"
  class="h-svh w-full overflow-hidden bg-white px-4 pb-4 pt-24 sm:px-5 sm:pb-5 sm:pt-28 md:px-6 md:pb-6 md:pt-32"
>
  <div class="relative h-full w-full overflow-hidden">
    <Image
      src={heroImg}
      alt={siteConfig.ja.author}
      class="absolute inset-0 h-full w-full object-cover object-center"
      loading="eager"
      fetchpriority="high"
    />

    <div
      class="absolute inset-0 bg-gradient-to-t from-black/65 via-black/15 to-transparent"
      aria-hidden="true"
    >
    </div>

    <div
      class="absolute inset-x-0 bottom-0 p-5 text-white sm:p-7 md:bottom-auto md:top-[55%] md:-translate-y-1/2 md:p-10 lg:p-12"
    >
      <div class="w-fit">
        <h1 class="text-[clamp(3rem,15vw,10rem)] font-medium leading-[0.8] tracking-[-0.05em]">
          {hero.title}
        </h1>

        <p
          class="mt-5 w-full text-center text-[clamp(0.1rem,4.2vw,2.5rem)] uppercase leading-none tracking-[0.1em] text-white/80"
        >
          {hero.tagline}
        </p>
      </div>
    </div>
  </div>
</section>

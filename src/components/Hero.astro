---
import { Image } from 'astro:assets';
import { siteConfig } from '../data/site';
import heroImg from '../assets/images/common/hero.jpg';

const hero = siteConfig.en.hero;
---

<section
  id="top"
  class="h-svh w-full overflow-hidden bg-white px-4 pb-4 pt-24 sm:px-5 sm:pb-5 sm:pt-28 md:px-6 md:pb-6 md:pt-32"
>
  <div
    class="relative h-full w-full overflow-hidden"
  >
    <Image
      src={heroImg}
      alt={siteConfig.ja.author}
      class="absolute inset-0 h-full w-full object-cover object-center"
      loading="eager"
    />

    <div
      class="absolute inset-0 bg-gradient-to-t from-black/65 via-black/15 to-transparent"
      aria-hidden="true"
    ></div>

    <div class="absolute inset-x-0 bottom-0 p-5 text-white sm:p-7 md:p-10 lg:p-12">
      <div class="flex flex-col justify-end gap-5 md:grid md:grid-cols-[minmax(0,1fr)_auto] md:items-end md:gap-10">
        <div class="min-w-0">
          <p class="text-[10px] font-medium uppercase tracking-[0.24em] text-white/75 sm:text-xs">
            {hero.eyebrow}
          </p>

          <h1 class="mt-3 text-[clamp(3rem,15vw,10rem)] font-medium leading-[0.8] tracking-[-0.07em]">
            {hero.title}
          </h1>

          <p class="mt-4 max-w-md text-[10px] font-medium uppercase tracking-[0.18em] text-white/80 sm:text-xs md:mt-5">
            {hero.tagline}
          </p>
        </div>

        <p class="text-[10px] font-medium uppercase tracking-[0.18em] text-white/75 sm:text-xs md:pb-1 md:text-right">
          {hero.meta}
        </p>
      </div>
    </div>
  </div>
</section>

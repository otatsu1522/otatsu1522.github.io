---
import { getCollection, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { ui } from '../data/ui';

const toDateNumber = (date?: string) => {
  if (!date) return 0;
  const match = date.trim().match(/^(\d{4})[/-](\d{1,2})[/-](\d{1,2})$/);
  if (!match) return 0;
  return Number(match[1]) * 10000 + Number(match[2]) * 100 + Number(match[3]);
};

const journeys: CollectionEntry<'journeys'>[] = (await getCollection('journeys'))
  .filter((entry) => entry.data.published)
  .sort((a, b) => toDateNumber(b.data.date) - toDateNumber(a.data.date));
---

<section id="journey" class="pt-20 pb-0">
  <div class="mb-10 text-center">
    <h2 class="text-4xl font-bold tracking-tight text-[var(--color-text)] md:text-5xl lg:text-6xl">
      <span class="lang-ja">{ui.ja.sections.journeyTitle}</span>
      <span class="lang-en">{ui.en.sections.journeyTitle}</span>
    </h2>
  </div>

  {journeys.length > 0 ? (
    <div class="relative">
      <div
        id="journey-container"
        class="-mx-4 flex w-[calc(100%+2rem)] snap-x snap-mandatory gap-4 overflow-x-auto px-[10vw] pb-4 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden md:relative md:left-1/2 md:-translate-x-1/2 md:w-[calc(100vw-8rem)] md:mx-0 md:gap-6 md:px-0"
      >
        {journeys.map((item) => (
          <a
            href={`/journeys/${item.id}`}
            class="group/card flex w-[80vw] max-w-[80vw] shrink-0 snap-center flex-col md:w-[calc((100%_-_3rem)/3)] md:max-w-none md:snap-start"
          >
            {item.data.cover && (
              <div class="aspect-[4/3] w-full shrink-0 overflow-hidden bg-[var(--color-border)]">
                <Image
                  src={item.data.cover}
                  alt={item.data.title}
                  class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover/card:scale-105"
                />
              </div>
            )}

            <div class="flex flex-1 flex-col pt-5">
              {item.data.date && item.data.showDate && (
                <time class="block text-[10px] font-mono tracking-[0.2em] text-[var(--color-muted)]">
                  {item.data.date}
                </time>
              )}

              <div class="mt-3 mb-4 h-px w-10 bg-[var(--color-accent-teal)] transition-all duration-500 group-hover/card:w-16"></div>

              <h3 class="min-h-[4.5rem] text-xl font-bold leading-tight tracking-tight text-[var(--color-text)] md:text-2xl lg:text-3xl">
                {item.data.title}
              </h3>

              <p class="mt-3 min-h-[4.5rem] line-clamp-3 text-sm leading-relaxed text-[var(--color-muted)] md:text-base">
                {item.data.summary}
              </p>

              <div class="mt-auto pt-6">
                <span class="inline-block border-b border-[var(--color-text)] pb-1 text-sm font-bold tracking-[0.12em] text-[var(--color-text)] transition-all duration-300 group-hover/card:border-[var(--color-accent-teal)] group-hover/card:text-[var(--color-accent-teal)]">
                  <span class="lang-ja">{ui.ja.buttons.readArticle}</span>
                  <span class="lang-en">{ui.en.buttons.readArticle}</span>
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <div class="hidden">
        <button
          id="journey-scroll-left"
          type="button"
          aria-label="Scroll left"
        ></button>

        <button
          id="journey-scroll-right"
          type="button"
          aria-label="Scroll right"
        ></button>
      </div>

      <div class="mt-10 flex justify-center">
        <a
          href="/journeys/"
          class="text-2xl font-bold tracking-[0.16em] text-[var(--color-accent-teal)] transition-opacity duration-300 hover:opacity-50 md:text-3xl"
        >
          MORE
        </a>
      </div>
    </div>
  ) : (
    <div class="py-4 text-sm text-[var(--color-muted)]">
      <span class="lang-ja">{ui.ja.messages.noJourneys}</span>
      <span class="lang-en">{ui.en.messages.noJourneys}</span>
    </div>
  )}
</section>

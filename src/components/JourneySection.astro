---
import { getCollection, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { ui } from '../data/ui';

const journeys: CollectionEntry<'journeys'>[] = await getCollection('journeys');
---

<section id="journey" class="pt-20 pb-0">
  <div class="flex items-baseline gap-2 mb-6">
    <h2 class="text-2xl font-bold text-white">
      <span class="lang-ja">{ui.ja.sections.journeyTitle}</span>
      <span class="lang-en">{ui.en.sections.journeyTitle}</span>
    </h2>
    <span class="lang-ja text-xs text-gray-400">{ui.ja.sections.journeySubtitle}</span>
    <span class="lang-en text-xs text-gray-400">{ui.en.sections.journeySubtitle}</span>
  </div>

  <div class="relative group">
    <button
      id="journey-scroll-left"
      type="button"
      aria-label="Scroll left"
      class="absolute left-1 md:-left-16 top-1/2 -translate-y-1/2 z-20 w-9 h-9 md:w-10 md:h-10 bg-slate-900/90 hover:bg-slate-800 border border-slate-700 text-white flex items-center justify-center backdrop-blur-md transition-all shadow-lg hover:scale-105 active:scale-95"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
    </button>

    <button
      id="journey-scroll-right"
      type="button"
      aria-label="Scroll right"
      class="absolute right-1 md:-right-16 top-1/2 -translate-y-1/2 z-20 w-9 h-9 md:w-10 md:h-10 bg-slate-900/90 hover:bg-slate-800 border border-slate-700 text-white flex items-center justify-center backdrop-blur-md transition-all shadow-lg hover:scale-105 active:scale-95"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
      </svg>
    </button>

    <div
      id="journey-container"
      class="-mx-4 w-[calc(100%+2rem)] md:mx-0 md:w-auto flex space-x-2 md:space-x-4 overflow-x-auto pb-2 snap-x snap-mandatory scroll-smooth [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden"
    >
      {journeys.length > 0 ? (
        journeys.map((item) => (
          <a
            href={`/journeys/${item.id}`}
            class="snap-center md:snap-start shrink-0 w-[80vw] md:w-[calc((100%-2rem)/3)] bg-slate-800 border border-slate-700/60 overflow-hidden flex flex-col justify-between transition-all hover:border-slate-500 group/card"
          >
            {item.data.cover && (
              <div class="w-full h-36 overflow-hidden bg-slate-950 shrink-0">
                <Image
                  src={item.data.cover}
                  alt={item.data.title}
                  class="w-full h-full object-cover group-hover/card:scale-105 transition-transform duration-300"
                />
              </div>
            )}

            <div class="p-4 flex-1 flex flex-col justify-between bg-slate-800">
              <div>
                {item.data.date && (
                  <span class="text-xs font-mono text-gray-400 block mb-1">
                    {item.data.date}
                  </span>
                )}

                <h3 class="text-sm font-bold text-white group-hover/card:text-blue-400 transition-colors line-clamp-2 mb-2">
                  {item.data.title}
                </h3>

                <p class="text-xs text-gray-300 line-clamp-2 leading-relaxed">
                  {item.data.summary}
                </p>
              </div>

              <div class="mt-4 text-xs font-medium text-slate-300 flex items-center gap-1 group-hover/card:translate-x-1 transition-transform">
                <span class="lang-ja">{ui.ja.buttons.readArticle}</span>
                <span class="lang-en">{ui.en.buttons.readArticle}</span>
                <span>&rarr;</span>
              </div>
            </div>
          </a>
        ))
      ) : (
        <div class="text-sm text-gray-500 py-4">
          <span class="lang-ja">{ui.ja.messages.noJourneys}</span>
          <span class="lang-en">{ui.en.messages.noJourneys}</span>
        </div>
      )}
    </div>
  </div>
</section>

<script>
  function setupJourneyScroll() {
    const container = document.getElementById('journey-container');
    const leftBtn = document.getElementById('journey-scroll-left');
    const rightBtn = document.getElementById('journey-scroll-right');

    if (!container || !leftBtn || !rightBtn) return;
    if (container.dataset.infiniteInitialized === 'true') return;

    const originalItems = Array.from(container.children);

    if (!originalItems.length) return;

    originalItems.forEach((item) => {
      container.appendChild(item.cloneNode(true));
    });

    originalItems.forEach((item) => {
      container.appendChild(item.cloneNode(true));
    });

    const updateLoop = () => {
      const setWidth = container.scrollWidth / 3;

      if (container.scrollLeft < setWidth * 0.5) {
        container.scrollLeft += setWidth;
      } else if (container.scrollLeft > setWidth * 1.5) {
        container.scrollLeft -= setWidth;
      }
    };

    const setWidth = container.scrollWidth / 3;

    if (window.matchMedia('(max-width: 767px)').matches) {
      const middleFirstItem = container.children[originalItems.length] as HTMLElement;

      if (middleFirstItem) {
        const centerOffset =
          (container.clientWidth - middleFirstItem.getBoundingClientRect().width) / 2;

        container.scrollLeft = middleFirstItem.offsetLeft - centerOffset;
      } else {
        container.scrollLeft = setWidth;
      }
    } else {
      container.scrollLeft = setWidth;
    }

    container.addEventListener('scroll', updateLoop, { passive: true });

    leftBtn.addEventListener('click', () => {
      if (window.matchMedia('(max-width: 767px)').matches) {
        const item = container.querySelector('a') as HTMLElement | null;
        const itemWidth = item ? item.getBoundingClientRect().width : container.clientWidth;

        container.scrollBy({
          left: -(itemWidth + 8),
          behavior: 'smooth',
        });
      } else {
        container.scrollBy({
          left: -container.clientWidth,
          behavior: 'smooth',
        });
      }
    });

    rightBtn.addEventListener('click', () => {
      if (window.matchMedia('(max-width: 767px)').matches) {
        const item = container.querySelector('a') as HTMLElement | null;
        const itemWidth = item ? item.getBoundingClientRect().width : container.clientWidth;

        container.scrollBy({
          left: itemWidth + 8,
          behavior: 'smooth',
        });
      } else {
        container.scrollBy({
          left: container.clientWidth,
          behavior: 'smooth',
        });
      }
    });

    container.dataset.infiniteInitialized = 'true';
  }

  setupJourneyScroll();
  document.addEventListener('astro:after-swap', setupJourneyScroll);
</script>

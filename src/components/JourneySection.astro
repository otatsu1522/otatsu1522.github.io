---
import { getCollection, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { ui } from '../data/ui';

const journeys: CollectionEntry<'journeys'>[] = await getCollection('journeys');
---

<section id="journey" class="pt-20 pb-0">
  <div class="flex items-baseline gap-2 mb-6">
    <h2 class="text-2xl font-bold text-white">
      <span class="lang-ja">{ui.ja.sections.journeyTitle}</span>
      <span class="lang-en">{ui.en.sections.journeyTitle}</span>
    </h2>
    <span class="lang-ja text-xs text-gray-400">{ui.ja.sections.journeySubtitle}</span>
    <span class="lang-en text-xs text-gray-400">{ui.en.sections.journeySubtitle}</span>
  </div>

  <div class="relative group">
    <button
      id="journey-scroll-left"
      type="button"
      aria-label="Scroll left"
      class="absolute left-1 md:-left-16 top-1/2 -translate-y-1/2 z-20 w-9 h-9 md:w-10 md:h-10 bg-slate-900/90 hover:bg-slate-800 border border-slate-700 text-white flex items-center justify-center backdrop-blur-md transition-all shadow-lg hover:scale-105 active:scale-95"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
    </button>

    <button
      id="journey-scroll-right"
      type="button"
      aria-label="Scroll right"
      class="absolute right-1 md:-right-16 top-1/2 -translate-y-1/2 z-20 w-9 h-9 md:w-10 md:h-10 bg-slate-900/90 hover:bg-slate-800 border border-slate-700 text-white flex items-center justify-center backdrop-blur-md transition-all shadow-lg hover:scale-105 active:scale-95"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
      </svg>
    </button>

    <div
      id="journey-container"
      class="-mx-4 w-[calc(100%+2rem)] md:mx-0 md:w-auto flex space-x-2 md:space-x-4 overflow-x-auto pb-2 snap-x snap-mandatory [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden"
    >
      {journeys.length > 0 ? (
        journeys.map((item) => (
          <a
            href={`/journeys/${item.id}`}
            class="snap-center md:snap-start shrink-0 w-[80vw] md:w-[calc((100%-2rem)/3)] bg-slate-800 border border-slate-700/60 overflow-hidden flex flex-col justify-between transition-all hover:border-slate-500 group/card"
          >
            {item.data.cover && (
              <div class="w-full h-36 overflow-hidden bg-slate-950 shrink-0">
                <Image
                  src={item.data.cover}
                  alt={item.data.title}
                  class="w-full h-full object-cover group-hover/card:scale-105 transition-transform duration-300"
                />
              </div>
            )}

            <div class="p-4 flex-1 flex flex-col justify-between bg-slate-800">
              <div>
                {item.data.date && (
                  <span class="text-xs font-mono text-gray-400 block mb-1">
                    {item.data.date}
                  </span>
                )}

                <h3 class="text-sm font-bold text-white group-hover/card:text-blue-400 transition-colors line-clamp-2 mb-2">
                  {item.data.title}
                </h3>

                <p class="text-xs text-gray-300 line-clamp-2 leading-relaxed">
                  {item.data.summary}
                </p>
              </div>

              <div class="mt-4 text-xs font-medium text-slate-300 flex items-center gap-1 group-hover/card:translate-x-1 transition-transform">
                <span class="lang-ja">{ui.ja.buttons.readArticle}</span>
                <span class="lang-en">{ui.en.buttons.readArticle}</span>
                <span>&rarr;</span>
              </div>
            </div>
          </a>
        ))
      ) : (
        <div class="text-sm text-gray-500 py-4">
          <span class="lang-ja">{ui.ja.messages.noJourneys}</span>
          <span class="lang-en">{ui.en.messages.noJourneys}</span>
        </div>
      )}
    </div>
  </div>
</section>

<script>
  function setupJourneyScroll() {
    const container = document.getElementById('journey-container');
    const leftBtn = document.getElementById('journey-scroll-left');
    const rightBtn = document.getElementById('journey-scroll-right');

    if (!container || !leftBtn || !rightBtn) return;
    if (container.dataset.infiniteInitialized === 'true') return;

    const originalItems = Array.from(container.children);
    if (!originalItems.length || container.querySelector('.text-gray-500')) return;

    const itemCount = originalItems.length;

    // 2セット分クローンを作成（計3セット）
    originalItems.forEach((item) => {
      container.appendChild(item.cloneNode(true));
    });

    originalItems.forEach((item) => {
      container.appendChild(item.cloneNode(true));
    });

    let isButtonScrolling = false;
    let finishTimer: number | undefined;

    /*
     * 現在のレイアウト情報を取得する。
     *
     * anchor:
     *   2セット目の先頭カードを「通常表示する位置」
     *
     * setWidth:
     *   同じカードが次のセットに現れるまでの正確な距離
     *
     * itemStep:
     *   隣のカードへ移動する正確な距離
     */
    const getLayout = () => {
      const firstItem = container.children[0] as HTMLElement | undefined;
      const secondItem = container.children[1] as HTMLElement | undefined;
      const secondSetFirstItem = container.children[itemCount] as HTMLElement | undefined;

      if (!firstItem || !secondSetFirstItem) return null;

      const isMobile = window.matchMedia('(max-width: 767px)').matches;

      const itemStep =
        secondItem
          ? secondItem.offsetLeft - firstItem.offsetLeft
          : secondSetFirstItem.offsetLeft - firstItem.offsetLeft;

      const setWidth =
        secondSetFirstItem.offsetLeft - firstItem.offsetLeft;

      /*
       * スマホは snap-center のため、
       * カードの左端ではなくカード中央がコンテナ中央に来る位置が基準になる。
       */
      const centerOffset = isMobile
        ? (container.clientWidth - secondSetFirstItem.offsetWidth) / 2
        : 0;

      const anchor =
        secondSetFirstItem.offsetLeft - centerOffset;

      return {
        isMobile,
        itemStep,
        setWidth,
        anchor,
      };
    };

    /*
     * 現在位置を中央セットと同じ見た目の位置へ戻す。
     *
     * scrollLeft自体は変化するが、
     * 表示されているカード列は全く同じになる。
     */
    const normalizePosition = () => {
      const layout = getLayout();
      if (!layout || layout.setWidth <= 0) return;

      let position = container.scrollLeft;

      while (position < layout.anchor) {
        position += layout.setWidth;
      }

      while (position > layout.anchor + layout.setWidth) {
        position -= layout.setWidth;
      }

      if (position !== container.scrollLeft) {
        container.scrollLeft = position;
      }
    };

    /*
     * 初期表示は必ず2セット目から開始する。
     */
    const initScrollPosition = () => {
      const layout = getLayout();
      if (!layout || layout.setWidth <= 0) return;

      container.scrollLeft = layout.anchor;
    };

    initScrollPosition();

    /*
     * 画像の読み込み後、カードサイズが確定した状態でもう一度計算する。
     */
    const images = container.querySelectorAll('img');

    images.forEach((img) => {
      if (!img.complete) {
        img.addEventListener('load', initScrollPosition, { once: true });
      }
    });

    /*
     * ユーザーによる通常の横スクロール。
     *
     * 中央セットの範囲から1セット分外れたら、
     * 同じ表示位置を別セットへ移動する。
     */
    const updateLoop = () => {
      if (isButtonScrolling) return;

      const layout = getLayout();
      if (!layout || layout.setWidth <= 0) return;

      let position = container.scrollLeft;

      if (position < layout.anchor) {
        position += layout.setWidth;
      } else if (position > layout.anchor + layout.setWidth) {
        position -= layout.setWidth;
      }

      if (position !== container.scrollLeft) {
        container.scrollLeft = position;
      }
    };

    container.addEventListener('scroll', updateLoop, { passive: true });

    /*
     * スムーススクロール終了後に中央セットへ戻す。
     *
     * これをスムーススクロール中に行うと、
     * ボタンを押したときに途中でジャンプしてしまうため、
     * スクロール完了後だけ実行する。
     */
    const finishButtonScroll = () => {
      if (!isButtonScrolling) return;

      isButtonScrolling = false;

      if (finishTimer !== undefined) {
        window.clearTimeout(finishTimer);
        finishTimer = undefined;
      }

      normalizePosition();
    };

    /*
     * scrollend対応ブラウザでは正確に終了を検知する。
     */
    container.addEventListener('scrollend', finishButtonScroll);

    /*
     * scrollend非対応環境用のフォールバック。
     */
    const scrollWithButton = (direction: number) => {
      const layout = getLayout();
      if (!layout || layout.itemStep <= 0) return;

      let current = container.scrollLeft;
      let amount = layout.isMobile
        ? layout.itemStep
        : container.clientWidth;

      let target = current + amount * direction;

      /*
       * 3セットの範囲から外れる場合は、
       * スクロール開始前に同じ位置を別セットへ移す。
       *
       * これにより「端まで行ってから逆方向へ突然飛ぶ」ことを防ぐ。
       */
      while (target < 0) {
        current += layout.setWidth;
        target += layout.setWidth;
      }

      while (target > container.scrollWidth - container.clientWidth) {
        current -= layout.setWidth;
        target -= layout.setWidth;
      }

      /*
       * 必要なら、スクロール開始位置だけを同じ表示位置へ移動。
       */
      if (current !== container.scrollLeft) {
        container.scrollLeft = current;
      }

      isButtonScrolling = true;

      container.scrollTo({
        left: target,
        behavior: 'smooth',
      });

      if (finishTimer !== undefined) {
        window.clearTimeout(finishTimer);
      }

      finishTimer = window.setTimeout(() => {
        finishButtonScroll();
      }, 800);
    };

    /*
     * 左ボタン
     */
    leftBtn.addEventListener('click', () => {
      const layout = getLayout();
      if (!layout) return;

      scrollWithButton(layout.isMobile ? 1 : -1);
    });

    /*
     * 右ボタン
     */
    rightBtn.addEventListener('click', () => {
      const layout = getLayout();
      if (!layout) return;

      scrollWithButton(layout.isMobile ? -1 : 1);
    });

    container.dataset.infiniteInitialized = 'true';
  }

  setupJourneyScroll();
  document.addEventListener('astro:after-swap', setupJourneyScroll);
</script>

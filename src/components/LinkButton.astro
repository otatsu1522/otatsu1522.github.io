---
interface Props {
  href: string;
  label?: string;
  handle?: string;
  external?: boolean;
  variant?: 'light' | 'dark';
}

const { href, label, handle, external = false, variant = 'light' } = Astro.props;

const variantClass =
  variant === 'dark'
    ? 'bg-white border-white text-black hover:bg-neutral-900 hover:text-white'
    : 'bg-white border-black text-black hover:bg-black hover:text-white';
---

<a
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  class:list={[
    'block p-4 border transition-all text-sm flex justify-between items-center group relative z-10',
    variantClass,
  ]}
>
  <div>
    <span><slot>{label}</slot></span>
    {handle && (
      <span class="text-xs text-neutral-500 group-hover:text-neutral-300 ml-2 font-mono">
        {handle}
      </span>
    )}
  </div>
  <span class="group-hover:translate-x-1 transition-transform">→</span>
</a>

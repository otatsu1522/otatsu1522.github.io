---
// LanguageSwitcher.astro が .js-ja / .js-en を toggle する前提の
// 「日本語+英語スパンを並べる」パターンを1箇所にまとめたもの。
// これまで home.astro 内に同じ形が10箇所近く手書きされていた。
interface Props {
  ja: string;
  en: string;
  class?: string;
}

const { ja, en, class: className = '' } = Astro.props;
---

<span class:list={['js-ja', className]}>{ja}</span><span
  class:list={['js-en', 'hidden', className]}>{en}</span
>

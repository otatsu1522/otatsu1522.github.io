---
interface Props {
  count?: number;             // 同時表示数
  minSize?: number;           // 最小サイズ(px)
  maxSizeRatio?: number;      // 画面短辺に対する最大サイズ比率 (0.1 ~ 1.0)
  sizeDistribution?: number;  // サイズの偏り（数値が大きいほど小さい四角が多くなる）
  borderWidth?: number;       // 枠線の太さ(px)
  minOpacity?: number;        // 不透明度の下限 (0.0 ~ 1.0)
  maxOpacity?: number;        // 不透明度の上限 (0.0 ~ 1.0)
  minFadeSpeed?: number;      // フェード速度の下限（大きいほど高速）
  maxFadeSpeed?: number;      // フェード速度の上限
  minHoldTime?: number;       // 画面内滞在フレーム数の下限（小さいほど高速で消える）
  maxHoldTime?: number;       // 画面内滞在フレーム数の上限
}

const {
  count = 100,
  minSize = 4,
  maxSizeRatio = 0.8,
  sizeDistribution = 4,
  borderWidth = 1,
  minOpacity = 0.2,
  maxOpacity = 0.9,
  minFadeSpeed = 0.025,
  maxFadeSpeed = 0.07,
  minHoldTime = 5,
  maxHoldTime = 20,
} = Astro.props;

const config = {
  count,
  minSize,
  maxSizeRatio,
  sizeDistribution,
  borderWidth,
  minOpacity,
  maxOpacity,
  minFadeSpeed,
  maxFadeSpeed,
  minHoldTime,
  maxHoldTime,
};
---

<canvas
  id="square-bg"
  class="fixed inset-0 w-full h-full pointer-events-none z-10 mix-blend-difference"
  data-config={JSON.stringify(config)}
></canvas>

<script>
  function initSquareBg() {
    const canvas = document.getElementById('square-bg') as HTMLCanvasElement | null;
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    // datasetから設定値を取り出し
    const CONFIG = JSON.parse(canvas.dataset.config || '{}');

    let width = window.innerWidth;
    let height = window.innerHeight;

    function resizeCanvas() {
      if (!canvas || !ctx) return;

      const dpr = window.devicePixelRatio || 1;

      width = window.innerWidth;
      height = window.innerHeight;

      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;

      // 以降はCSSピクセル基準で描画できるようにスケールを設定
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    resizeCanvas();

    window.addEventListener('resize', resizeCanvas);

    interface Square {
      x: number;
      y: number;
      size: number;
      gray: number;
      maxOpacity: number;
      opacity: number;
      state: 'in' | 'hold' | 'out';
      fadeSpeed: number;
      holdTime: number;
    }

    function createSquare(): Square {
      const maxSize = Math.min(width, height) * CONFIG.maxSizeRatio;
      const random = Math.random();
      const size = CONFIG.minSize + (maxSize - CONFIG.minSize) * Math.pow(random, CONFIG.sizeDistribution);
      const gray = Math.floor(Math.random() * 256);
      const targetOpacity = CONFIG.minOpacity + Math.random() * (CONFIG.maxOpacity - CONFIG.minOpacity);

      return {
        x: Math.random() * width,
        y: Math.random() * height,
        size,
        gray,
        maxOpacity: targetOpacity,
        opacity: 0,
        state: 'in',
        fadeSpeed: CONFIG.minFadeSpeed + Math.random() * (CONFIG.maxFadeSpeed - CONFIG.minFadeSpeed),
        holdTime: Math.floor(CONFIG.minHoldTime + Math.random() * (CONFIG.maxHoldTime - CONFIG.minHoldTime))
      };
    }

    const squares: Square[] = [];

    for (let i = 0; i < CONFIG.count; i++) {
      const sq = createSquare();
      sq.opacity = Math.random() * sq.maxOpacity;
      sq.state = Math.random() > 0.5 ? 'in' : 'out';
      squares.push(sq);
    }

    function animate() {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);

      for (let i = 0; i < squares.length; i++) {
        let sq = squares[i];

        if (sq.state === 'in') {
          sq.opacity += sq.fadeSpeed;
          if (sq.opacity >= sq.maxOpacity) {
            sq.opacity = sq.maxOpacity;
            sq.state = 'hold';
          }
        } else if (sq.state === 'hold') {
          sq.holdTime--;
          if (sq.holdTime <= 0) {
            sq.state = 'out';
          }
        } else if (sq.state === 'out') {
          sq.opacity -= sq.fadeSpeed;
          if (sq.opacity <= 0) {
            squares[i] = createSquare();
            continue;
          }
        }

        ctx.strokeStyle = `rgba(${sq.gray}, ${sq.gray}, ${sq.gray}, ${Math.max(0, sq.opacity)})`;
        ctx.lineWidth = CONFIG.borderWidth;
        ctx.beginPath();
        ctx.rect(
          Math.floor(sq.x - sq.size / 2) + 0.5,
          Math.floor(sq.y - sq.size / 2) + 0.5,
          Math.floor(sq.size),
          Math.floor(sq.size)
        );
        ctx.stroke();
      }

      requestAnimationFrame(animate);
    }

    animate();
  }

  initSquareBg();
</script>

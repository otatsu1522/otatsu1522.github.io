---
import { Image } from 'astro:assets';
import { siteConfig } from '../data/site';
import photo1 from '../assets/images/common/photo1.jpg';
import photo2 from '../assets/images/common/photo2.jpg';
import photo3 from '../assets/images/common/photo3.jpg';
---

<section class="pt-20">
  <div class="mb-8 flex justify-center">
    <div class="relative h-[29rem] w-80 sm:h-[32rem] sm:w-96 md:h-[36rem] md:w-[28rem]">
      <div class="absolute top-0 left-[4%] z-10 w-[168px] sm:w-[192px] md:w-[240px]">
        <Image src={photo1} alt="" class="block h-auto w-full shadow-lg" />
      </div>

      <div class="absolute top-[31%] right-[1%] z-20 w-[168px] sm:w-[192px] md:w-[240px]">
        <Image src={photo2} alt="" class="block h-auto w-full shadow-lg" />
      </div>

      <div class="absolute top-[75%] left-[4%] z-30 w-[276px] sm:w-[315px] md:w-[396px]">
        <Image src={photo3} alt="" class="block h-auto w-full shadow-lg" />
      </div>
    </div>
  </div>

  <div class="pt-40 pb-20 text-center">
    <p
      class="w-full text-[clamp(1.5rem,7vw,5rem)] leading-none font-bold tracking-tight whitespace-nowrap text-[var(--color-text)]"
    >
      <span class="lang-ja">{siteConfig.ja.message}</span>
      <span class="lang-en">{siteConfig.en.message}</span>
    </p>

    <div class="mt-8 flex items-center justify-center gap-4">
      <span class="text-base tracking-[0.18em] text-[var(--color-muted)]">
        BY {siteConfig.en.author}
      </span>
    </div>
  </div>
</section>

---
import { Image } from 'astro:assets';
import { siteConfig } from '../data/site';
import photo1 from '../assets/images/common/photo1.jpg';
import photo2 from '../assets/images/common/photo2.jpg';
import photo3 from '../assets/images/common/photo3.jpg';
---

<section class="pt-20">
  <div class="mb-8 flex justify-center">
    <div class="relative h-[29rem] w-80 sm:h-[32rem] sm:w-96 md:h-[36rem] md:w-[28rem]">
      <div class="absolute left-[4%] top-0 z-10 w-[168px] sm:w-[192px] md:w-[240px]">
        <Image
          src={photo1}
          alt=""
          class="block h-auto w-full shadow-lg"
        />
      </div>

      <div class="absolute right-[1%] top-[31%] z-20 w-[168px] sm:w-[192px] md:w-[240px]">
        <Image
          src={photo2}
          alt=""
          class="block h-auto w-full shadow-lg"
        />
      </div>

      <div class="absolute left-[4%] top-[66%] z-30 w-[276px] sm:w-[315px] md:w-[396px]">
        <Image
          src={photo3}
          alt=""
          class="block h-auto w-full shadow-lg"
        />
      </div>
    </div>
  </div>

  <div class="text-center pt-32  pb-32">
    <p class="text-3xl font-bold tracking-tight text-[var(--color-text)] sm:text-4xl md:text-5xl">
      <span class="lang-ja">{siteConfig.ja.message}</span>
      <span class="lang-en">{siteConfig.en.message}</span>
    </p>

    <div class="mt-10 flex items-center justify-center gap-4">
      <span class="text-xs font-mono tracking-[0.18em] text-[var(--color-muted)]">
        BY {siteConfig.en.author}
      </span>
    </div>
  </div>
</section>

---
import { Image } from 'astro:assets';
import { siteConfig } from '../data/site';
import profileImg from '../assets/images/common/profile.jpg';
---

<section class="py-50">
  <div class="text-center">
    <p class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">
      <span class="lang-ja">{siteConfig.ja.message}</span>
      <span class="lang-en">{siteConfig.en.message}</span>
    </p>

    <div class="mt-8 flex items-center justify-center gap-3 pl-8">
      <span class="text-sm  text-white">BY</span>

      <Image
        src={profileImg}
        alt={siteConfig.en.author}
        class="w-20 h-20 rounded-full object-cover border border-white/15"
      />

      <span class="text-sm font-medium text-white">
        {siteConfig.en.author}
      </span>
    </div>
  </div>
</section>

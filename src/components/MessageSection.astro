---
import { Image } from 'astro:assets';
import { siteConfig } from '../data/site';
import profileImg from '../assets/images/common/profile.jpg';
---

<section class="py-60">
  <div class="text-center">
    <p class="text-3xl font-bold tracking-tight text-[var(--color-text)] sm:text-4xl md:text-5xl">
      <span class="lang-ja">{siteConfig.ja.message}</span>
      <span class="lang-en">{siteConfig.en.message}</span>
    </p>

    <div class="mt-10 flex items-center justify-center gap-4">
      <span class="text-xs font-mono tracking-[0.18em] text-[var(--color-muted)]">
        BY {siteConfig.en.author}
      </span>
    </div>
  </div>
</section>

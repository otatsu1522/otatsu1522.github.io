---
import { Image } from 'astro:assets';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Bilingual from '../ui/Bilingual.astro';
import { profileData } from '../../data/profile';
import { siteText } from '../../data/site';
import profileImage from '../../assets/images/profile.jpg';
---

<Section theme="dark" scrollable>
  <div
    class="max-w-4xl w-full flex flex-col-reverse md:flex-row items-center justify-between gap-8 md:gap-16 py-8"
  >
    <div class="flex-1 space-y-4 text-left">
      <SectionHeading
        eyebrow={siteText.sections.about.eyebrow}
        titleJa={siteText.sections.about.titleJa}
        titleEn={siteText.sections.about.titleEn}
        theme="dark"
      />
      <div class="bg-black p-4">
        <p class="text-neutral-300 text-sm md:text-base leading-relaxed whitespace-pre-line">
          <Bilingual ja={profileData.about.ja} en={profileData.about.en} />
        </p>
      </div>
    </div>
    <div class="shrink-0 bg-black p-2">
      <Image
        src={profileImage}
        alt={profileData.name.ja}
        width={192}
        height={192}
        class="w-48 h-48 mx-auto object-cover border border-neutral-700"
      />
    </div>
  </div>
</Section>

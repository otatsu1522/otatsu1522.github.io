---
import { Image } from 'astro:assets';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { siteText } from '../../data/site';
import mapImage from '../../assets/images/summary/map.jpg';
import statsImage from '../../assets/images/summary/stats.jpg';
import mapStatsImage from '../../assets/images/summary/map-stats.jpg';
---

<!-- PC: 地図と統計をそれぞれ別画像・別タイトルで横並び。
     スマホ: 縦に並べると上下がはみ出るため、1枚にまとめた画像・1つの見出しで表示。
     CSSの表示切替(hidden/flex)だけで出し分け、画像自体はどちらも常に読み込む。 -->
<Section>
  <!-- PC表示: 地図・統計を別々に -->
  <div class="hidden md:flex max-w-5xl w-full flex-row items-start gap-12">
    <div class="w-1/2 flex flex-col items-start gap-4">
      <SectionHeading
        eyebrow={siteText.sections.map.eyebrow}
        titleJa={siteText.sections.map.titleJa}
        titleEn={siteText.sections.map.titleEn}
      />
      <Image
        src={mapImage}
        alt={siteText.sections.map.titleJa}
        height={800}
        class="w-full h-auto max-h-[70vh] object-contain"
      />
    </div>
    <div class="w-1/2 flex flex-col items-start gap-4">
      <SectionHeading
        eyebrow={siteText.sections.stats.eyebrow}
        titleJa={siteText.sections.stats.titleJa}
        titleEn={siteText.sections.stats.titleEn}
      />
      <Image
        src={statsImage}
        alt={siteText.sections.stats.titleJa}
        height={800}
        class="w-full h-auto max-h-[70vh] object-contain"
      />
    </div>
  </div>

  <!-- スマホ表示: 地図・統計をまとめた1枚の画像・1つの見出し -->
  <div class="flex md:hidden max-w-xl w-full flex-col items-start gap-4">
    <SectionHeading
      eyebrow={siteText.sections.mapStats.eyebrow}
      titleJa={siteText.sections.mapStats.titleJa}
      titleEn={siteText.sections.mapStats.titleEn}
    />
    <Image
      src={mapStatsImage}
      alt={siteText.sections.mapStats.titleJa}
      height={1000}
      class="w-full h-auto max-h-[75vh] object-contain"
    />
  </div>
</Section>

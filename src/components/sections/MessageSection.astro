---
import Section from '../ui/Section.astro';
import Bilingual from '../ui/Bilingual.astro';
import { profileData } from '../../data/profile';
import { siteText } from '../../data/site';
---

<Section theme="dark" class="!justify-between py-12 text-center">
  <div></div>
  <div class="max-w-xl w-full space-y-4 flex flex-col items-center">
    <p class="text-xs tracking-widest text-neutral-400 font-mono uppercase">
      {siteText.sections.message.eyebrow}
    </p>
    <h2 class="text-2xl md:text-3xl font-extrabold text-white leading-relaxed">
      <Bilingual ja={profileData.tagline.ja} en={profileData.tagline.en} />
    </h2>
  </div>
  <p class="w-full pb-4 text-center text-xs text-neutral-500 font-mono">
    {siteText.copyright}
  </p>
</Section>

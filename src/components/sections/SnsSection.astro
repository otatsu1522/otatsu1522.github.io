---
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { profileData } from '../../data/profile';
import { siteText } from '../../data/site';

const snsCount = profileData.links.sns.length;
const cols = snsCount <= 4 ? snsCount : Math.ceil(snsCount / 2);
---

<Section class="gap-8">
  <div class="max-w-4xl w-full mx-auto">
    <SectionHeading
      eyebrow={siteText.sections.sns.eyebrow}
      titleJa={siteText.sections.sns.titleJa}
      titleEn={siteText.sections.sns.titleEn}
    />
  </div>

  <!-- PCでは件数に応じて列数を自動計算し、きれいに行を分ける
       （4件までは1行、5件なら3+2、7件なら4+3、というように）。
       スマホは常に1列（変更なし）。 -->
  <div
    class="sns-grid max-w-4xl w-full mx-auto grid grid-cols-1 gap-4"
    style={`--sns-cols: ${cols}`}
  >
    {profileData.links.sns.map((sns) => (
      <a
        href={sns.url}
        target="_blank"
        rel="noopener noreferrer"
        class="p-5 bg-white border border-black hover:bg-black hover:text-white transition-all text-center group"
      >
        <div class="font-bold text-black group-hover:text-white">{sns.name}</div>
        <div class="text-xs text-neutral-500 group-hover:text-neutral-300 mt-1">
          {sns.handle}
        </div>
      </a>
    ))}
  </div>
</Section>

<style>
  @media (min-width: 768px) {
    .sns-grid {
      grid-template-columns: repeat(var(--sns-cols), minmax(0, 1fr));
    }
  }
</style>

---
import { recommendedPlaylists, type Recommendation } from '../data/recommend';
import { ui } from '../data/ui';

const videos = recommendedPlaylists.filter((item) => item.type === 'video');
const playlists = recommendedPlaylists.filter((item) => item.type === 'playlist');

const getYouTubeEmbedUrl = (url: string) => {
  const videoId = new URL(url).searchParams.get('v');
  return videoId ? `https://www.youtube.com/embed/${videoId}` : url;
};
---

<section id="recommend" class="pt-20 pb-0">
  <div class="flex items-baseline gap-2 mb-6">
    <h2 class="text-2xl font-bold text-white">
      <span class="lang-ja">{ui.ja.sections.recommendTitle}</span>
      <span class="lang-en">{ui.en.sections.recommendTitle}</span>
    </h2>
    <span class="lang-ja text-xs text-gray-400">{ui.ja.sections.recommendSubtitle}</span>
    <span class="lang-en text-xs text-gray-400">{ui.en.sections.recommendSubtitle}</span>
  </div>

  <div class="space-y-8">
    {videos.length > 0 && (
      <div class="space-y-3">
        {videos.map((item: Recommendation) => (
          item.type === 'video' && (
            <div class="overflow-hidden border border-white/10 bg-white/5">
              <div class="aspect-video">
                <iframe
                  src={getYouTubeEmbedUrl(item.url)}
                  title={item.title.ja}
                  class="w-full h-full"
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  allowfullscreen
                ></iframe>
              </div>
            </div>
          )
        ))}
      </div>
    )}

    {playlists.length > 0 && (
      <div>
        <div class="flex items-baseline justify-center gap-2 mb-4">
          <h3 class="text-lg font-semibold text-white">
            <span class="lang-ja">{ui.ja.sections.recommendedPlaylistsTitle}</span>
            <span class="lang-en">{ui.en.sections.recommendedPlaylistsTitle}</span>
          </h3>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          {playlists.map((item: Recommendation) => (
            item.type === 'playlist' && (
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                class="block text-center bg-white/5 p-4 border border-white/10 text-gray-300 hover:text-white hover:border-white/20 hover:bg-white/10 font-medium transition-all"
              >
                <span class="lang-ja">{item.title.ja}</span>
                <span class="lang-en">{item.title.en}</span>
              </a>
            )
          ))}
        </div>
      </div>
    )}
  </div>
</section>

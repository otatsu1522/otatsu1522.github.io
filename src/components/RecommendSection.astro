---
import { Image } from 'astro:assets';
import { recommendedPlaylists, type Recommendation } from '../data/recommend';
import { ui } from '../data/ui';
import SectionHeading from './common/SectionHeading.astro';
import playlistJapanImg from '../assets/images/common/playlist-japan-round.jpg';
import playlistWorldImg from '../assets/images/common/playlist-world-round.jpg';
import playlistAmericaImg from '../assets/images/common/playlist-north-america.jpg';

const videos = recommendedPlaylists.filter((item) => item.type === 'video');
const playlists = recommendedPlaylists.filter((item) => item.type === 'playlist');

const getYouTubeId = (url: string) => new URL(url).searchParams.get('v');

const getYouTubeEmbedUrl = (url: string) => {
  const videoId = getYouTubeId(url);
  return videoId ? `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1` : url;
};

const getYouTubeThumbnailUrl = (url: string) => {
  const videoId = getYouTubeId(url);
  return videoId ? `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg` : '';
};

const getPlaylistImage = (id: string) => {
  if (id === 'japan-round') return playlistJapanImg;
  if (id === 'world-round') return playlistWorldImg;
  if (id === 'north-america') return playlistAmericaImg;
  return playlistJapanImg;
};
---

<section id="recommend" class="pt-10">
  <SectionHeading ja={ui.ja.sections.recommendTitle} en={ui.en.sections.recommendTitle} />

  {
    videos.length > 0 && (
      <div class="w-full">
        {videos.map(
          (item: Recommendation) =>
            item.type === 'video' && (
              <div class="overflow-hidden bg-black">
                <div class="aspect-video" data-youtube-facade>
                  <button
                    type="button"
                    data-youtube-play
                    class="group relative block h-full w-full cursor-pointer"
                  >
                    <img
                      src={getYouTubeThumbnailUrl(item.url)}
                      alt=""
                      loading="lazy"
                      class="h-full w-full object-cover"
                    />

                    <span class="absolute inset-0 flex items-center justify-center bg-black/20 transition-colors duration-300 group-hover:bg-black/10">
                      <svg
                        class="h-16 w-16 text-white transition-transform duration-300 group-hover:scale-110 md:h-20 md:w-20"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        aria-hidden="true"
                      >
                        <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm-2 14.5v-9l7 4.5-7 4.5Z" />
                      </svg>
                    </span>

                    <span class="sr-only">
                      <span class="lang-ja">{ui.ja.buttons.playVideo}</span>
                      <span class="lang-en">{ui.en.buttons.playVideo}</span>
                    </span>
                  </button>

                  <template>
                    <iframe
                      src={getYouTubeEmbedUrl(item.url)}
                      title={item.title.ja}
                      class="h-full w-full"
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                      allowfullscreen
                    />
                  </template>
                </div>
              </div>
            ),
        )}
      </div>
    )
  }
</section>

{
  playlists.length > 0 && (
    <section id="playlist" class="pt-10">
      <SectionHeading ja={ui.ja.sections.playlistTitle} en={ui.en.sections.playlistTitle} />

      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {playlists.map(
          (item: Recommendation) =>
            item.type === 'playlist' && (
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group relative block overflow-hidden"
              >
                <div class="aspect-[16/10] overflow-hidden bg-border">
                  <Image
                    src={getPlaylistImage(item.id)}
                    alt={item.title.ja}
                    class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                  />

                  <div class="absolute inset-0 bg-black/35 transition-colors duration-500 group-hover:bg-black/20" />

                  <div class="absolute inset-x-0 bottom-0 p-6 md:p-8">
                    <div class="h-px w-8 bg-white transition-all duration-300 group-hover:w-14" />

                    <h3 class="mt-4 text-2xl font-bold tracking-tight text-white md:text-3xl">
                      <span class="lang-ja">{item.title.ja}</span>
                      <span class="lang-en">{item.title.en}</span>
                    </h3>

                    <span class="mt-3 inline-block text-xs font-semibold tracking-[0.18em] text-white/80 transition-colors duration-300 group-hover:text-white">
                      YOUTUBE PLAYLIST
                    </span>
                  </div>
                </div>
              </a>
            ),
        )}
      </div>
    </section>
  )
}

<script>
  document.querySelectorAll<HTMLElement>('[data-youtube-facade]').forEach((facade) => {
    const template = facade.querySelector('template');

    facade.querySelector('[data-youtube-play]')?.addEventListener(
      'click',
      () => {
        if (template) facade.replaceChildren(template.content.cloneNode(true));
      },
      { once: true },
    );
  });
</script>

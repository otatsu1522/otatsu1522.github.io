---
import Layout from '../../layouts/Layout.astro';
import Pagination from '../../components/common/Pagination.astro';
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ui } from '../../data/ui';

const galleryImages = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>(
    '../../assets/images/gallery/*.{jpg,jpeg,png,webp,avif}',
    { eager: true }
  )
)
  .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
  .map(([, module]) => module.default);

const fullImageSrcs = await Promise.all(
  galleryImages.map(async (image) =>
    (await getImage({ src: image, width: image.width })).src
  )
);

const PAGE_SIZE = 10;
---

<Layout title={ui.ja.sections.galleryTitle}>
  <main class="max-w-3xl mx-auto px-4 pt-20 pb-10">
    <header class="mb-8">
      <h1 class="text-2xl md:text-4xl font-extrabold text-white leading-tight">
        <span class="lang-ja">{ui.ja.sections.galleryTitle}</span>
        <span class="lang-en">{ui.en.sections.galleryTitle}</span>
      </h1>

      <p class="text-sm text-gray-400 mt-3">
        <span class="lang-ja">{ui.ja.sections.gallerySubtitle}</span>
        <span class="lang-en">{ui.en.sections.gallerySubtitle}</span>
      </p>
    </header>

    {galleryImages.length > 0 ? (
      <>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 sm:gap-3">
          {galleryImages.map((image, index) => (
            <button
              type="button"
              class="group block w-full aspect-square overflow-hidden bg-gray-500"
              data-gallery-open
              data-full-src={fullImageSrcs[index]}
              data-pagination-item="gallery"
              data-pagination-index={index}
            >
              <Image
                src={image}
                alt={`${ui.ja.sections.galleryTitle} ${index + 1}`}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading={index < PAGE_SIZE ? 'eager' : 'lazy'}
              />
            </button>
          ))}
        </div>

        <Pagination
          target="gallery"
          totalItems={galleryImages.length}
          pageSize={10}
          mobilePageSize={10}
          desktopPageSize={15}
        />
      </>
    ) : (
      <div class="bg-gray-800/50 border border-gray-800 p-10 text-center text-sm text-gray-500">
        <span class="lang-ja">{ui.ja.messages.noPosts}</span>
        <span class="lang-en">{ui.en.messages.noPosts}</span>
      </div>
    )}
  </main>

  <div
    id="gallery-lightbox"
    class="hidden fixed inset-0 z-[9999] bg-black/95 flex-col items-center justify-center p-4 md:p-8"
    aria-hidden="true"
  >
    <div class="gallery-lightbox-stage">
      <img
        id="gallery-lightbox-image"
        src=""
        alt=""
        class="gallery-lightbox-image"
      />
    </div>

    <button
      id="gallery-lightbox-close"
      type="button"
      aria-label="Close"
      class="fixed top-5 right-4 sm:right-6 z-[10000] p-2 text-gray-300 focus:outline-none cursor-pointer"
    >
      <svg
        class="w-6 h-6"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"
        ></path>
      </svg>
    </button>
  </div>
</Layout>

<style>
  #gallery-lightbox.flex {
    display: flex;
  }

  .gallery-lightbox-stage {
    width: 100%;
    max-width: calc(100vw - 2rem);
    height: calc(100dvh - 2rem);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .gallery-lightbox-image {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
  }

  @media (min-width: 768px) {
    .gallery-lightbox-stage {
      max-width: calc(100vw - 6rem);
      height: calc(100dvh - 3rem);
    }
  }
</style>

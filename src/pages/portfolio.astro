---
import { Image } from 'astro:assets';
import Layout from '../components/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Bilingual from '../components/Bilingual.astro';
import LinkButton from '../components/LinkButton.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import MusicPlayer from '../components/MusicPlayer.astro';
import TopButton from '../components/TopButton.astro';
import CursorTrail from '../components/CursorTrail.astro';
import SquareBackground from '../components/SquareBackground.astro';
import ScrollNav from '../components/ScrollNav.astro';
import Gallery from '../components/Gallery.astro';
import SpecTable from '../components/SpecTable.astro';
import { profileData } from '../data/profile';
import { siteText } from '../data/site';
import { galleryJapanCaptions } from '../data/gallery-japan';
import { galleryWorldCaptions } from '../data/gallery-world';
import { bicycleJapan } from '../data/bicycle-japan';
import { bicycleWorld } from '../data/bicycle-world';
import { equipmentJapan } from '../data/equipment-japan';
import { equipmentWorld } from '../data/equipment-world';
import profileImage from '../assets/images/profile.jpg';
---

<Layout
  title={`${profileData.name.ja} | Portfolio`}
  bodyClass="bg-white text-black"
  htmlClass="scroll-smooth"
>
  <SquareBackground />
  <LanguageSwitcher />
  <TopButton />
  <MusicPlayer />
  <ScrollNav />
  <CursorTrail />
  <div
    id="scroll-container"
    class="h-screen w-full overflow-y-scroll overflow-x-hidden snap-y snap-mandatory scroll-smooth relative"
  >
    <!-- ================= 1. ウェルカムページ (白) ================= -->
    <section
      class="h-screen w-full snap-start flex flex-col justify-center items-center px-6 relative bg-white text-black border-b border-neutral-300"
    >
      <div class="text-center space-y-4 max-w-2xl w-full relative z-20 flex flex-col items-center">
        <p class="text-xs tracking-widest text-neutral-500 uppercase font-mono">
          {siteText.sections.welcome.eyebrow}
        </p>
        <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-black">
          <Bilingual ja={profileData.name.ja} en={profileData.name.en} />
        </h1>
      </div>
    </section>

    <!-- ================= 2. 自己紹介 (黒) ================= -->
    <section
      class="h-screen w-full snap-start flex items-center justify-center px-6 md:px-12 bg-black text-white border-b border-neutral-700 overflow-y-auto"
    >
      <div
        class="max-w-4xl w-full flex flex-col-reverse md:flex-row items-center justify-between gap-8 md:gap-16 relative z-20 py-8"
      >
        <div class="flex-1 space-y-4 text-left">
          <SectionHeading
            eyebrow={siteText.sections.about.eyebrow}
            titleJa={siteText.sections.about.titleJa}
            titleEn={siteText.sections.about.titleEn}
            theme="dark"
          />
          <div class="bg-black p-4">
            <p class="text-neutral-300 text-sm md:text-base leading-relaxed whitespace-pre-line">
              <Bilingual ja={profileData.about.ja} en={profileData.about.en} />
            </p>
          </div>
        </div>
        <div class="shrink-0 bg-black p-2">
          <Image
            src={profileImage}
            alt={profileData.name.ja}
            width={192}
            height={192}
            class="w-48 h-48 mx-auto object-cover border border-neutral-700"
          />
        </div>
      </div>
    </section>

    <!-- ================= 3. 旅歴 (白) ================= -->
    <section
      class="h-screen w-full snap-start flex items-center justify-center px-6 md:px-12 bg-white text-black border-b border-neutral-300 overflow-y-auto"
    >
      <div
        class="max-w-4xl w-full flex flex-col md:flex-row items-start justify-between gap-6 md:gap-16 relative z-20 py-8"
      >
        <div class="w-full md:w-1/3 shrink-0">
          <SectionHeading
            eyebrow={siteText.sections.history.eyebrow}
            titleJa={siteText.sections.history.titleJa}
            titleEn={siteText.sections.history.titleEn}
          />
        </div>
        <div class="w-full md:w-2/3 bg-white p-4 space-y-3">
          {profileData.history.map((item) => (
            <div class="flex items-baseline gap-4 pb-2 border-b border-neutral-300 last:border-none last:pb-0">
              <span class="text-xs font-mono text-neutral-600 w-32 shrink-0">{item.period}</span>
              <div>
                <h4 class="text-xs md:text-sm font-semibold text-black">
                  <Bilingual ja={item.title.ja} en={item.title.en} />
                </h4>
                {item.desc && (
                  <p class="text-[11px] text-neutral-600 mt-0.5">
                    <Bilingual ja={item.desc.ja} en={item.desc.en} />
                  </p>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ================= 4. ギャラリー：日本一周 (黒) ================= -->
    <section
      class="h-screen w-full snap-start flex flex-col justify-center px-6 md:px-12 bg-black text-white border-b border-neutral-700 gap-8"
    >
      <div class="max-w-4xl w-full mx-auto relative z-20">
        <SectionHeading
          eyebrow={siteText.sections.galleryJapan.eyebrow}
          titleJa={siteText.sections.galleryJapan.titleJa}
          titleEn={siteText.sections.galleryJapan.titleEn}
          theme="dark"
        />
      </div>
      <Gallery dir="japan" captions={galleryJapanCaptions} />
    </section>

    <!-- ================= 5. 自転車：日本一周 (白) ================= -->
    <!-- 左上: タイトル+写真 / 右: 表（スマホは縦積み：タイトル→写真→表） -->
    <section
      class="h-screen w-full snap-start flex items-center justify-center px-6 md:px-12 bg-white text-black border-b border-neutral-300 overflow-y-auto"
    >
      <div
        class="max-w-4xl w-full flex flex-col md:flex-row items-start gap-6 md:gap-12 relative z-20 py-8"
      >
        <div class="w-full md:w-1/2 space-y-4">
          <SectionHeading
            eyebrow={siteText.sections.bicycleJapan.eyebrow}
            titleJa={siteText.sections.bicycleJapan.titleJa}
            titleEn={siteText.sections.bicycleJapan.titleEn}
          />
          <Image
            src={bicycleJapan.photo}
            alt={siteText.sections.bicycleJapan.titleJa}
            height={320}
            class="h-56 md:h-64 w-auto max-w-full object-contain border border-neutral-300"
          />
        </div>
        <div class="w-full md:w-1/2">
          <SpecTable rows={bicycleJapan.rows} />
        </div>
      </div>
    </section>

    <!-- ================= 6. 装備：日本一周 (黒) ================= -->
    <section
      class="h-screen w-full snap-start flex items-center justify-center px-6 md:px-12 bg-black text-white border-b border-neutral-700 overflow-y-auto"
    >
      <div
        class="max-w-4xl w-full flex flex-col md:flex-row items-start gap-6 md:gap-12 relative z-20 py-8"
      >
        <div class="w-full md:w-1/2 space-y-4">
          <SectionHeading
            eyebrow={siteText.sections.gearJapan.eyebrow}
            titleJa={siteText.sections.gearJapan.titleJa}
            titleEn={siteText.sections.gearJapan.titleEn}
            theme="dark"
          />
          <Image
            src={equipmentJapan.photo}
            alt={siteText.sections.gearJapan.titleJa}
            height={320}
            class="h-56 md:h-64 w-auto max-w-full object-contain border border-neutral-700"
          />
        </div>
        <div class="w-full md:w-1/2">
          <SpecTable rows={equipmentJapan.rows} theme="dark" />
        </div>
      </div>
    </section>

    <!-- ================= 7. ギャラリー：世界一周 (白) ================= -->
    <section
      class="h-screen w-full snap-start flex flex-col justify-center px-6 md:px-12 bg-white text-black border-b border-neutral-300 gap-8"
    >
      <div class="max-w-4xl w-full mx-auto relative z-20">
        <SectionHeading
          eyebrow={siteText.sections.galleryWorld.eyebrow}
          titleJa={siteText.sections.galleryWorld.titleJa}
          titleEn={siteText.sections.galleryWorld.titleEn}
        />
      </div>
      <Gallery dir="world" captions={galleryWorldCaptions} />
    </section>

    <!-- ================= 8. 自転車：世界一周 (黒) ================= -->
    <section
      class="h-screen w-full snap-start flex items-center justify-center px-6 md:px-12 bg-black text-white border-b border-neutral-700 overflow-y-auto"
    >
      <div
        class="max-w-4xl w-full flex flex-col md:flex-row items-start gap-6 md:gap-12 relative z-20 py-8"
      >
        <div class="w-full md:w-1/2 space-y-4">
          <SectionHeading
            eyebrow={siteText.sections.bicycleWorld.eyebrow}
            titleJa={siteText.sections.bicycleWorld.titleJa}
            titleEn={siteText.sections.bicycleWorld.titleEn}
            theme="dark"
          />
          <Image
            src={bicycleWorld.photo}
            alt={siteText.sections.bicycleWorld.titleJa}
            height={320}
            class="h-56 md:h-64 w-auto max-w-full object-contain border border-neutral-700"
          />
        </div>
        <div class="w-full md:w-1/2">
          <SpecTable rows={bicycleWorld.rows} theme="dark" />
        </div>
      </div>
    </section>

    <!-- ================= 9. 装備：世界一周 (白) ================= -->
    <section
      class="h-screen w-full snap-start flex items-center justify-center px-6 md:px-12 bg-white text-black border-b border-neutral-300 overflow-y-auto"
    >
      <div
        class="max-w-4xl w-full flex flex-col md:flex-row items-start gap-6 md:gap-12 relative z-20 py-8"
      >
        <div class="w-full md:w-1/2 space-y-4">
          <SectionHeading
            eyebrow={siteText.sections.gearWorld.eyebrow}
            titleJa={siteText.sections.gearWorld.titleJa}
            titleEn={siteText.sections.gearWorld.titleEn}
          />
          <Image
            src={equipmentWorld.photo}
            alt={siteText.sections.gearWorld.titleJa}
            height={320}
            class="h-56 md:h-64 w-auto max-w-full object-contain border border-neutral-300"
          />
        </div>
        <div class="w-full md:w-1/2">
          <SpecTable rows={equipmentWorld.rows} />
        </div>
      </div>
    </section>

    <!-- ================= 10. おすすめ動画 (黒) ================= -->
    <section
      class="h-screen w-full snap-start flex items-center justify-center px-6 md:px-12 bg-black text-white border-b border-neutral-700"
    >
      <!-- グリッドで組むことで、DOM順（タイトル→動画→リンク）を保ったままPCでは「左にタイトル＋リンク / 右に動画」の2カラムに配置できる。
           スマホ(1カラム)では自動的に タイトル→動画→リンク の縦並びになる。 -->
      <div
        class="max-w-4xl w-full grid grid-cols-1 md:grid-cols-2 items-center gap-6 md:gap-12 relative z-20"
      >
        <!-- タイトル: PCは左カラム上段 -->
        <div class="md:col-start-1 md:row-start-1">
          <SectionHeading
            eyebrow={siteText.sections.recommend.eyebrow}
            titleJa={siteText.sections.recommend.titleJa}
            titleEn={siteText.sections.recommend.titleEn}
            theme="dark"
          />
        </div>

        <!-- 動画: PCは右カラムで上下段にまたがる -->
        <div
          class="w-full aspect-video border border-neutral-700 bg-neutral-900 md:col-start-2 md:row-start-1 md:row-span-2"
        >
          <iframe
            id="youtube-player"
            class="yt-player w-full h-full"
            src={`https://www.youtube.com/embed/${profileData.links.recommendedVideoId}?enablejsapi=1`}
            title="YouTube player"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>

        <!-- 再生リストへのリンク: PCは左カラム下段 -->
        <div class="space-y-3 md:col-start-1 md:row-start-2">
          {profileData.links.playlists.map((pl) => (
            <LinkButton href={pl.url} external variant="dark">
              <Bilingual ja={pl.title.ja} en={pl.title.en} />
            </LinkButton>
          ))}
        </div>
      </div>
    </section>

    <!-- ================= 11. SNSリンク集 (白) ================= -->
    <section
      class="h-screen w-full snap-start flex items-center justify-center px-6 md:px-12 bg-white text-black border-b border-neutral-300"
    >
      <div
        class="max-w-4xl w-full flex flex-col md:flex-row items-start justify-between gap-6 md:gap-12 relative z-20"
      >
        <div class="w-full md:w-1/3 shrink-0">
          <SectionHeading
            eyebrow={siteText.sections.sns.eyebrow}
            titleJa={siteText.sections.sns.titleJa}
            titleEn={siteText.sections.sns.titleEn}
          />
        </div>
        <div class="w-full md:w-2/3 grid grid-cols-1 md:grid-cols-2 gap-4">
          {profileData.links.sns.map((sns) => (
            <a
              href={sns.url}
              target="_blank"
              rel="noopener noreferrer"
              class="p-5 bg-white border border-black hover:bg-black hover:text-white transition-all text-center group relative z-10"
            >
              <div class="font-bold text-black group-hover:text-white">{sns.name}</div>
              <div class="text-xs text-neutral-500 group-hover:text-neutral-300 mt-1">
                {sns.handle}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ================= 12. メッセージ (黒) ＋ コピーライト ================= -->
    <section
      class="h-screen w-full snap-start flex flex-col justify-between items-center px-6 py-12 bg-black text-white text-center"
    >
      <div></div>
      <div class="max-w-xl w-full space-y-4 relative z-20 flex flex-col items-center">
        <p class="text-xs tracking-widest text-neutral-400 font-mono uppercase">
          {siteText.sections.message.eyebrow}
        </p>
        <h2 class="text-2xl md:text-3xl font-extrabold text-white leading-relaxed">
          <Bilingual ja={profileData.tagline.ja} en={profileData.tagline.en} />
        </h2>
      </div>
      <p class="w-full relative z-20 pb-4 text-center text-xs text-neutral-500 font-mono">
        {siteText.copyright}
      </p>
    </section>
  </div>

  <script src="../scripts/scrollTheme.ts"></script>

  <!-- YouTube再生時にBGMを止める連携スクリプト -->
  <script is:inline>
    const tag = document.createElement('script');
    tag.src = 'https://www.youtube.com/iframe_api';
    const firstScriptTag = document.getElementsByTagName('script')[0];
    firstScriptTag.parentNode.insertBefore(tag, firstScriptTag);
    function onPlayerStateChange(event) {
      if (event.data === YT.PlayerState.PLAYING) {
        window.dispatchEvent(new CustomEvent('stop-bgm'));
      }
    }
    function onYouTubeIframeAPIReady() {
      document.querySelectorAll('.yt-player').forEach((iframe) => {
        new YT.Player(iframe.id, {
          events: {
            onStateChange: onPlayerStateChange,
          },
        });
      });
    }
  </script>
</Layout>

---
import Layout from '../components/layout/Layout.astro';
import SquareBackground from '../components/global/SquareBackground.astro';
import LanguageSwitcher from '../components/global/LanguageSwitcher.astro';
import TopButton from '../components/global/TopButton.astro';
import MusicPlayer from '../components/global/MusicPlayer.astro';
import ScrollNav from '../components/global/ScrollNav.astro';
import CursorTrail from '../components/global/CursorTrail.astro';

import GallerySection from '../components/ui/GallerySection.astro';
import SpecSection from '../components/ui/SpecSection.astro';

import WelcomeSection from '../components/sections/WelcomeSection.astro';
import AboutSection from '../components/sections/AboutSection.astro';
import HistorySection from '../components/sections/HistorySection.astro';
import MapStatsSection from '../components/sections/MapStatsSection.astro';
import RecommendSection from '../components/sections/RecommendSection.astro';
import SnsSection from '../components/sections/SnsSection.astro';
import MessageSection from '../components/sections/MessageSection.astro';

import { profileData } from '../data/profile';
import { siteText } from '../data/site';
import { galleryJapanCaptions } from '../data/gallery-japan';
import { galleryWorldCaptions } from '../data/gallery-world';
import { bicycleJapan } from '../data/bicycle-japan';
import { bicycleWorld } from '../data/bicycle-world';
import { equipment } from '../data/equipment';
---

<Layout title={`${profileData.name.ja} | Portfolio`} bodyClass="bg-white text-black" htmlClass="scroll-smooth">
  <SquareBackground />
  <LanguageSwitcher />
  <TopButton />
  <MusicPlayer />
  <ScrollNav />
  <CursorTrail />

  <div
    id="scroll-container"
    class="h-screen w-full overflow-y-scroll overflow-x-hidden overscroll-y-none snap-y snap-mandatory scroll-smooth relative"
  >
    <WelcomeSection />
    <AboutSection />
    <HistorySection />

    <GallerySection
      eyebrow={siteText.sections.galleryJapan.eyebrow}
      titleJa={siteText.sections.galleryJapan.titleJa}
      titleEn={siteText.sections.galleryJapan.titleEn}
      theme="dark"
      dir="japan"
      captions={galleryJapanCaptions}
    />
    <SpecSection
      eyebrow={siteText.sections.bicycleJapan.eyebrow}
      titleJa={siteText.sections.bicycleJapan.titleJa}
      titleEn={siteText.sections.bicycleJapan.titleEn}
      photo={bicycleJapan.photo}
      rows={bicycleJapan.rows}
    />

    <GallerySection
      eyebrow={siteText.sections.galleryWorld.eyebrow}
      titleJa={siteText.sections.galleryWorld.titleJa}
      titleEn={siteText.sections.galleryWorld.titleEn}
      theme="dark"
      dir="world"
      captions={galleryWorldCaptions}
    />
    <SpecSection
      eyebrow={siteText.sections.bicycleWorld.eyebrow}
      titleJa={siteText.sections.bicycleWorld.titleJa}
      titleEn={siteText.sections.bicycleWorld.titleEn}
      photo={bicycleWorld.photo}
      rows={bicycleWorld.rows}
    />

    <SpecSection
      eyebrow={siteText.sections.gear.eyebrow}
      titleJa={siteText.sections.gear.titleJa}
      titleEn={siteText.sections.gear.titleEn}
      theme="dark"
      photo={equipment.photo}
      rows={equipment.rows}
    />

    <MapStatsSection />
    <RecommendSection />
    <SnsSection />
    <MessageSection />
  </div>

  <script src="../scripts/scrollTheme.ts"></script>
</Layout>

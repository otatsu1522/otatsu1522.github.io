---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CurrentSection from '../components/CurrentSection.astro';
import AboutSection from '../components/AboutSection.astro';
import HistorySection from '../components/HistorySection.astro';
import FeaturedSection from '../components/FeaturedSection.astro';
import RecommendSection from '../components/RecommendSection.astro';
import LatestSection from '../components/LatestSection.astro';
import Banner from '../components/common/Banner.astro';
import SocialSection from '../components/SocialSection.astro';
import ContactSection from '../components/ContactSection.astro';
import MessageSection from '../components/MessageSection.astro';
import GalleryMarquee from '../components/common/GalleryMarquee.astro';
import { siteConfig } from '../data/site';
import { snsLinks } from '../data/sns';
import { defaultLanguage } from '../data/language';

const { author, bio } = siteConfig[defaultLanguage];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: author,
  description: bio,
  url: Astro.site?.href,
  sameAs: snsLinks.map((sns) => sns.url),
};
---

<Layout jsonLd={jsonLd}>
  <Hero />
  <CurrentSection />

  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <AboutSection />
    <HistorySection />
    <FeaturedSection />
    <RecommendSection />
    <LatestSection />
    <Banner />
    <SocialSection />
    <ContactSection />
    <MessageSection />
    <GalleryMarquee />
  </div>
</Layout>

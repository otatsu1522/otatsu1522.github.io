---
import { render, type CollectionEntry } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getPublishedEntries } from '../../utils/content';

export async function getStaticPaths() {
  const posts = await getPublishedEntries('posts');

  return posts.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'posts'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const posts = await getPublishedEntries('posts');

const currentIndex = posts.findIndex((item) => item.id === entry.id);
const previousEntry = currentIndex > 0 ? posts[currentIndex - 1] : undefined;
const nextEntry =
  currentIndex >= 0 && currentIndex < posts.length - 1 ? posts[currentIndex + 1] : undefined;
---

<ArticleLayout entry={entry} previous={previousEntry} next={nextEntry} basePath="/posts">
  <Content />
</ArticleLayout>

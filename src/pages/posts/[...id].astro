---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const posts = await getCollection('posts', (entry) => entry.data.published);

  return posts.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'posts'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={entry.data.title} description={entry.data.summary}>
  <main class="max-w-3xl mx-auto px-4 pt-20">
    <article class="bg-[var(--color-bg)] border border-[var(--color-border)] overflow-hidden">
      {entry.data.cover && (
        <div class="w-full bg-[var(--color-border)] border-b border-[var(--color-border)]">
          <Image
            src={entry.data.cover}
            alt={entry.data.title}
            class="w-full h-auto max-h-[480px] object-cover"
          />
        </div>
      )}

      <div class="p-6 md:p-10">
        <header class="border-b border-[var(--color-border)] pb-6 mb-8">
          {entry.data.date && entry.data.showDate && (
            <time class="text-sm text-[var(--color-muted)] font-mono mb-2 block">
              {entry.data.date}
            </time>
          )}

          <h1 class="text-2xl md:text-4xl font-extrabold text-[var(--color-text)] leading-tight">
            {entry.data.title}
          </h1>

          {entry.data.summary && (
            <p class="text-[var(--color-muted)] mt-4 text-base md:text-lg leading-relaxed">
              {entry.data.summary}
            </p>
          )}
        </header>

        <div
          class="
            text-[var(--color-text)] leading-7
            [&_h2]:text-xl [&_h2]:md:text-2xl [&_h2]:font-semibold [&_h2]:text-[var(--color-text)] [&_h2]:mt-12 [&_h2]:mb-5
            [&_h3]:text-lg [&_h3]:md:text-xl [&_h3]:font-semibold [&_h3]:text-[var(--color-text)] [&_h3]:mt-9 [&_h3]:mb-4
            [&_p]:mb-5
            [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:mb-6
            [&_ol]:list-decimal [&_ol]:pl-6 [&_ol]:mb-6
            [&_li]:mb-2
            [&_strong]:text-[var(--color-text)] [&_strong]:font-semibold
            [&_a]:text-[var(--color-accent-teal)] [&_a]:underline [&_a]:underline-offset-4 [&_a]:decoration-[var(--color-accent-teal)]/40 [&_a:hover]:opacity-70
            [&_code]:text-[var(--color-text)] [&_code]:bg-[var(--color-border)] [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:rounded
            [&_pre]:bg-[#1a1a1a] [&_pre]:text-[var(--color-bg)] [&_pre]:border [&_pre]:border-[#2a2a2a] [&_pre]:p-5 [&_pre]:overflow-x-auto [&_pre]:mb-7
            [&_pre_code]:bg-transparent [&_pre_code]:p-0 [&_pre_code]:text-inherit [&_pre_code]:rounded-none
            [&_blockquote]:my-8 [&_blockquote]:border-l-2 [&_blockquote]:border-[var(--color-accent-teal)] [&_blockquote]:pl-5 [&_blockquote]:text-[var(--color-muted)] [&_blockquote]:italic
            [&_hr]:border-[var(--color-border)] [&_hr]:my-10
            [&_table]:w-full [&_table]:border-collapse [&_table]:my-8
            [&_th]:border-b [&_th]:border-[var(--color-border)] [&_th]:px-3 [&_th]:py-2 [&_th]:text-left [&_th]:font-semibold
            [&_td]:border-b [&_td]:border-[var(--color-border)] [&_td]:px-3 [&_td]:py-2
            [&_img]:my-7
          "
        >
          <Content />
        </div>
      </div>
    </article>
  </main>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const posts = await getCollection('posts', (entry) => entry.data.published);

  return posts.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'posts'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={entry.data.title} description={entry.data.summary}>
  <main class="pb-20 pt-20">
    <article class="mx-auto max-w-5xl px-4 md:px-8">
      {
        entry.data.cover && (
          <div class="mb-12 w-full overflow-hidden md:mb-16">
            <Image
              src={entry.data.cover}
              alt={entry.data.title}
              class="h-auto max-h-[640px] w-full object-cover"
            />
          </div>
        )
      }

      <header class="mx-auto max-w-4xl border-b border-[var(--color-border)] pb-10 text-center">
        {
          entry.data.date && entry.data.showDate && (
            <time class="block text-xs tracking-[0.16em] text-[var(--color-muted)]">
              {entry.data.date}
            </time>
          )
        }

        <h1
          class="mt-4 text-3xl font-bold leading-tight tracking-tight text-[var(--color-text)] md:text-5xl"
        >
          {entry.data.title}
        </h1>

        {
          entry.data.summary && (
            <p class="mt-6 text-base leading-relaxed text-[var(--color-muted)] md:text-lg">
              {entry.data.summary}
            </p>
          )
        }
      </header>

      <div
        class="[&_a]:decoration-[var(--color-accent-teal)]/40 mx-auto mt-10 max-w-3xl leading-8 text-[var(--color-text)] [&_a:hover]:opacity-60 [&_a]:text-[var(--color-accent-teal)] [&_a]:underline [&_a]:underline-offset-4 [&_a]:transition-opacity [&_blockquote]:my-10 [&_blockquote]:border-l-2 [&_blockquote]:border-[var(--color-accent-teal)] [&_blockquote]:pl-5 [&_blockquote]:italic [&_blockquote]:text-[var(--color-muted)] [&_code]:rounded [&_code]:bg-[var(--color-border)] [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:text-[var(--color-text)] [&_h2]:mb-6 [&_h2]:mt-16 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:leading-tight [&_h2]:tracking-tight [&_h2]:text-[var(--color-text)] [&_h3]:mb-5 [&_h3]:mt-12 [&_h3]:text-xl [&_h3]:font-bold [&_h3]:leading-tight [&_h3]:text-[var(--color-text)] [&_hr]:my-12 [&_hr]:border-[var(--color-border)] [&_img]:my-10 [&_img]:w-full [&_li]:mb-2 [&_ol]:mb-7 [&_ol]:list-decimal [&_ol]:pl-6 [&_p]:mb-6 [&_pre]:mb-8 [&_pre]:overflow-x-auto [&_pre]:border [&_pre]:border-[#2a2a2a] [&_pre]:bg-[#1a1a1a] [&_pre]:p-5 [&_pre]:text-[var(--color-bg)] [&_pre_code]:bg-transparent [&_pre_code]:p-0 [&_pre_code]:text-inherit [&_strong]:font-semibold [&_strong]:text-[var(--color-text)] [&_table]:my-10 [&_table]:w-full [&_table]:border-collapse [&_td]:border-b [&_td]:border-[var(--color-border)] [&_td]:px-3 [&_td]:py-3 [&_th]:border-b [&_th]:border-[var(--color-border)] [&_th]:px-3 [&_th]:py-3 [&_th]:text-left [&_th]:font-semibold [&_ul]:mb-7 [&_ul]:list-disc [&_ul]:pl-6"
      >
        <Content />
      </div>
    </article>
  </main>
</Layout>

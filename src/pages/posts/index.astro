---
import Layout from '../../layouts/Layout.astro';
import Pagination from '../../components/common/Pagination.astro';
import PostCard from '../../components/common/PostCard.astro';
import SectionHeading from '../../components/common/SectionHeading.astro';
import { ui, type Language } from '../../data/ui';
import { getPublishedEntries } from '../../utils/content';

const sortedPosts = await getPublishedEntries('posts');

const lang: Language = 'ja';
const t = ui[lang];
---

<Layout title={t.sections.postsListTitle}>
  <div class="pt-20 pb-10">
    <SectionHeading
      as="h1"
      ja={ui.ja.sections.postsListTitle}
      en={ui.en.sections.postsListTitle}
      class="mx-auto max-w-5xl px-5 md:px-10"
    />

    {
      sortedPosts.length > 0 ? (
        <div class="mx-auto max-w-5xl px-6 md:px-8">
          <div>
            {sortedPosts.map((post, index) => (
              <PostCard
                entry={post}
                headingLevel="h2"
                data-pagination-item="posts"
                data-pagination-index={index}
              />
            ))}
          </div>
        </div>
      ) : (
        <div class="mx-auto max-w-5xl px-6 py-6 text-sm text-muted md:px-8">
          <span class="lang-ja">{ui.ja.messages.noPosts}</span>
          <span class="lang-en">{ui.en.messages.noPosts}</span>
        </div>
      )
    }

    <div class="mx-auto max-w-5xl px-6 md:px-8">
      <Pagination
        target="posts"
        totalItems={sortedPosts.length}
        mobilePageSize={10}
        desktopPageSize={10}
      />
    </div>
  </div>
</Layout>

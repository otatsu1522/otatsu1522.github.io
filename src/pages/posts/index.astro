---
import Layout from '../../layouts/Layout.astro';
import Pagination from '../../components/common/Pagination.astro';
import { ui, type Language } from '../../data/ui';
import { getCollection, type CollectionEntry } from 'astro:content';

const posts: CollectionEntry<'posts'>[] = (await getCollection('posts')).filter(
  (post) => post.data.published
);

const toDateNumber = (date?: string) => {
  if (!date) return 0;
  const match = date.trim().match(/^(\d{4})[/-](\d{1,2})[/-](\d{1,2})$/);
  if (!match) return 0;
  return Number(match[1]) * 10000 + Number(match[2]) * 100 + Number(match[3]);
};

const sortedPosts = posts.sort((a, b) => {
  return toDateNumber(b.data.date) - toDateNumber(a.data.date);
});

const lang: Language = 'ja';
const t = ui[lang];
---

<Layout title={t.sections.postsListTitle}>
  <main class="max-w-3xl mx-auto px-4 pt-20">
    <header class="mb-12">
      <div class="flex items-baseline gap-2 mb-6">
        <h1 class="text-2xl md:text-4xl font-extrabold text-[var(--color-text)] leading-tight">
          <span class="lang-ja">{ui.ja.sections.postsListTitle}</span>
          <span class="lang-en">{ui.en.sections.postsListTitle}</span>
        </h1>
        <span class="lang-ja text-xs text-[var(--color-muted)]">
          {ui.ja.sections.postsListSubtitle}
        </span>
        <span class="lang-en text-xs text-[var(--color-muted)]">
          {ui.en.sections.postsListSubtitle}
        </span>
      </div>
    </header>

    {sortedPosts.length > 0 ? (
      <div class="space-y-3 sm:space-y-4">
        {sortedPosts.map((post, index) => (
          <a
            href={`/posts/${post.id}`}
            data-pagination-item="posts"
            data-pagination-index={index}
            class="group block h-52 overflow-hidden bg-[var(--color-bg)] border border-[var(--color-border)] hover:border-[var(--color-text)] hover:bg-[var(--color-border)] transition-all"
          >
            <div class="h-full p-6 md:p-7 flex flex-col">
              {post.data.date && post.data.showDate && (
                <time class="text-sm text-[var(--color-muted)] font-mono">
                  {post.data.date}
                </time>
              )}

              <h2 class="text-xl md:text-2xl font-extrabold text-[var(--color-text)] mt-3 leading-tight group-hover:opacity-60 transition-colors line-clamp-2">
                {post.data.title}
              </h2>

              <p class="text-[var(--color-muted)] mt-4 text-sm md:text-base leading-relaxed line-clamp-3">
                {post.data.summary}
              </p>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="bg-[var(--color-bg)] border border-[var(--color-border)] p-10 text-center text-sm text-[var(--color-muted)]">
        <span class="lang-ja">{ui.ja.messages.noPosts}</span>
        <span class="lang-en">{ui.en.messages.noPosts}</span>
      </div>
    )}

    <Pagination
      target="posts"
      totalItems={sortedPosts.length}
      pageSize={10}
    />
  </main>
</Layout>

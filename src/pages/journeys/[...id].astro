---
import { render, type CollectionEntry } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getPublishedEntries } from '../../utils/content';

export async function getStaticPaths() {
  const journeys = await getPublishedEntries('journeys');

  return journeys.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'journeys'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const journeys = await getPublishedEntries('journeys');

const currentIndex = journeys.findIndex((item) => item.id === entry.id);
const previousEntry = currentIndex > 0 ? journeys[currentIndex - 1] : undefined;
const nextEntry =
  currentIndex >= 0 && currentIndex < journeys.length - 1 ? journeys[currentIndex + 1] : undefined;
---

<ArticleLayout entry={entry} previous={previousEntry} next={nextEntry} basePath="/journeys">
  <Content />
</ArticleLayout>

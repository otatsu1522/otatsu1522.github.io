---
import Layout from '../../layouts/Layout.astro';
import Pagination from '../../components/common/Pagination.astro';
import { ui, type Language } from '../../data/ui';
import { getCollection, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

const toDateNumber = (date?: string) => {
  if (!date) return 0;
  const match = date.trim().match(/^(\d{4})[/-](\d{1,2})[/-](\d{1,2})$/);
  if (!match) return 0;
  return Number(match[1]) * 10000 + Number(match[2]) * 100 + Number(match[3]);
};

const journeys: CollectionEntry<'journeys'>[] = (await getCollection('journeys'))
  .filter((entry) => entry.data.published)
  .sort((a, b) => {
    return toDateNumber(b.data.date) - toDateNumber(a.data.date);
  });

const lang: Language = 'ja';
const t = ui[lang];
---

<Layout title={t.sections.journeyListTitle}>
  <main class="pt-20 pb-20">
    <header class="mx-auto mb-16 max-w-7xl px-6 md:px-10 lg:px-12">
      <h1 class="text-4xl font-bold tracking-tight text-[var(--color-text)] md:text-6xl lg:text-7xl">
        <span class="lang-ja">{ui.ja.sections.journeyListTitle}</span>
        <span class="lang-en">{ui.en.sections.journeyListTitle}</span>
      </h1>
    </header>

    {journeys.length > 0 ? (
      <div class="mx-auto max-w-7xl px-6 md:px-10 lg:px-12">
        <div class="grid grid-cols-1 gap-x-8 gap-y-16 md:grid-cols-2 md:gap-y-20 lg:grid-cols-3 lg:gap-y-24">
          {journeys.map((item, index) => (
            <a
              href={`/journeys/${item.id}`}
              data-pagination-item="journeys"
              data-pagination-index={index}
              class="group block"
            >
              {item.data.cover && (
                <div class="aspect-[4/3] w-full overflow-hidden bg-[var(--color-border)]">
                  <Image
                    src={item.data.cover}
                    alt={item.data.title}
                    class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                  />
                </div>
              )}

              <div class="pt-5 md:pt-6">
                {item.data.date && item.data.showDate && (
                  <time class="block text-[10px] font-mono tracking-[0.2em] text-[var(--color-muted)]">
                    {item.data.date}
                  </time>
                )}

                <div class="mt-3 h-px w-10 bg-[var(--color-accent-teal)] transition-all duration-500 group-hover:w-16"></div>

                <h2 class="mt-4 text-xl font-bold leading-tight tracking-tight text-[var(--color-text)] md:text-2xl">
                  {item.data.title}
                </h2>

                <p class="mt-4 line-clamp-3 text-sm leading-relaxed text-[var(--color-muted)] md:text-base">
                  {item.data.summary}
                </p>

                <div class="mt-6">
                  <span class="inline-block border-b border-[var(--color-text)] pb-1 text-xs font-bold tracking-[0.16em] text-[var(--color-text)] transition-colors duration-300 group-hover:border-[var(--color-accent-teal)] group-hover:text-[var(--color-accent-teal)]">
                    <span class="lang-ja">{ui.ja.buttons.readArticle}</span>
                    <span class="lang-en">{ui.en.buttons.readArticle}</span>
                  </span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    ) : (
      <div class="mx-auto max-w-7xl px-6 py-10 text-center text-sm text-[var(--color-muted)] md:px-10 lg:px-12">
        <span class="lang-ja">{ui.ja.messages.noJourneys}</span>
        <span class="lang-en">{ui.en.messages.noJourneys}</span>
      </div>
    )}

    <div class="mx-auto mt-16 max-w-7xl px-6 md:px-10 lg:px-12">
      <Pagination
        target="journeys"
        totalItems={journeys.length}
        pageSize={20}
      />
    </div>
  </main>
</Layout>

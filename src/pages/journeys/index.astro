---
import Layout from '../../layouts/Layout.astro';
import Pagination from '../../components/common/Pagination.astro';
import JourneyCard from '../../components/common/JourneyCard.astro';
import SectionHeading from '../../components/common/SectionHeading.astro';
import { ui } from '../../data/ui';
import { defaultLanguage } from '../../data/language';
import { pageSizes } from '../../data/pagination';
import { getInitialPaginationClass } from '../../utils/pagination';
import { getPublishedEntries } from '../../utils/content';

const journeys = await getPublishedEntries('journeys');

const { mobile, desktop } = pageSizes.journeys;
---

<Layout title={ui[defaultLanguage].sections.journeyListTitle}>
  <div class="pt-20 pb-10">
    <SectionHeading
      as="h1"
      ja={ui.ja.sections.journeyListTitle}
      en={ui.en.sections.journeyListTitle}
      class="mx-auto max-w-6xl px-5 md:px-10"
    />

    {
      journeys.length > 0 ? (
        <div class="mx-auto max-w-7xl px-6 md:px-10 lg:px-12">
          <div class="grid grid-cols-1 gap-x-8 gap-y-16 md:grid-cols-2 md:gap-y-20 lg:grid-cols-3 lg:gap-y-24">
            {journeys.map((item, index) => (
              <JourneyCard
                entry={item}
                headingLevel="h2"
                data-pagination-item="journeys"
                data-pagination-index={index}
                class={getInitialPaginationClass(index, mobile, desktop)}
              />
            ))}
          </div>
        </div>
      ) : (
        <div class="mx-auto max-w-7xl px-6 py-10 text-center text-sm text-muted md:px-10 lg:px-12">
          <span class="lang-ja">{ui.ja.messages.noJourneys}</span>
          <span class="lang-en">{ui.en.messages.noJourneys}</span>
        </div>
      )
    }

    <div class="mx-auto mt-16 max-w-7xl px-6 md:px-10 lg:px-12">
      <Pagination
        target="journeys"
        totalItems={journeys.length}
        mobilePageSize={mobile}
        desktopPageSize={desktop}
      />
    </div>
  </div>
</Layout>
